/* ---------- GPS ---------- */
async function startTracking(){
  if(!navigator.geolocation) return toast('เครื่องนี้ไม่รองรับ GPS',true);
  if(S.trip.status!=='running'){
    await sb.from('trips').update({status:'running',started_at:new Date().toISOString()}).eq('id',S.trip.id);
    S.trip.status='running';
  }
  S.tracking = true; $('pulse').classList.add('on');
  $('statusBox').classList.add('live');
  $('stTitle').textContent = 'กำลังส่งตำแหน่ง';
  $('stSub').innerHTML = `เที่ยว #${S.trip.id} · ส่งทุก ${PING_SEC} วินาที · `
    + (NATIVE ? `<b style="color:var(--live)">โหมดแอป — พับจอ/สลับแอปได้</b>`
              : `<b style="color:var(--signal)">โหมดเว็บ — ต้องเปิดจอค้างไว้</b>`);
  if(!NATIVE){ try{ S.wake = await navigator.wakeLock?.request('screen'); }catch(e){} }
  startWatch();
  saveSession(); drawBar('scRun');
}
/* ============================================================
   แหล่ง GPS มี 2 ทาง
   1) โหมดแอป (Capacitor) — ปลั๊กอิน background geolocation ทำงานเป็น foreground service
      พับจอ สลับแอป ปิดจอ ก็ยังส่งตำแหน่งอยู่ มีแถบแจ้งเตือนค้างบนมือถือ
   2) โหมดเว็บ (เปิดในเบราว์เซอร์) — watchPosition ธรรมดา หยุดเมื่อไม่ได้อยู่หน้าจอ
   โค้ดตั้งแต่ onPos ลงไปใช้ร่วมกันทั้งสองโหมด ไม่ต้องแยกสองชุด
   ============================================================ */
const NATIVE = !!(window.Capacitor?.isNativePlatform?.()
              && window.Capacitor?.Plugins?.BackgroundGeolocation);
const BG = () => window.Capacitor.Plugins.BackgroundGeolocation;
let bgWatcher = null;

function startWatch(){
  if(NATIVE) return startWatchNative();
  if(!navigator.geolocation) return;
  if(S.watchId!=null) try{ navigator.geolocation.clearWatch(S.watchId); }catch(e){}
  S.watchId = navigator.geolocation.watchPosition(onPos,
    e=>toast('อ่าน GPS ไม่ได้: '+e.message,true),
    {enableHighAccuracy:true,maximumAge:5000,timeout:20000});
}
async function startWatchNative(){
  if(bgWatcher) return;                       // ตัวเดิมยังทำงานอยู่ ไม่ต้องเปิดซ้ำ
  try{
    bgWatcher = await BG().addWatcher({
      backgroundTitle: 'TMS · กำลังวิ่งงาน',
      backgroundMessage: 'กำลังส่งตำแหน่งให้ศูนย์ควบคุม',
      requestPermissions: true,
      stale: false,
      distanceFilter: 20                      // ขยับเกิน 20 ม. ค่อยรายงาน (ประหยัดแบต)
    }, (loc, err) => {
      if(err){
        /* ไม่ล้าง id ทิ้ง — ต้องเก็บไว้ปิด watcher ตอนกดหยุดวิ่ง ไม่งั้นค้างกินแบต */
        if(err.code === 'NOT_AUTHORIZED')
          toast('ต้องอนุญาตตำแหน่งแบบ "ตลอดเวลา" ในตั้งค่าแอปก่อน', true);
        else toast('อ่าน GPS ไม่ได้: '+(err.message||err.code), true);
        return;
      }
      if(!loc) return;
      onPos({coords:{ latitude:loc.latitude, longitude:loc.longitude,
        accuracy:loc.accuracy, speed:loc.speed, heading:loc.bearing }});
    });
  }catch(e){ bgWatcher=null; toast('เปิดการติดตามเบื้องหลังไม่สำเร็จ: '+e.message, true); }
}
async function stopWatchNative(){
  if(!bgWatcher) return;
  try{ await BG().removeWatcher({id:bgWatcher}); }catch(e){}
  bgWatcher = null;
}
async function stopTracking(){
  S.tracking=false; $('pulse').classList.remove('on'); $('statusBox').classList.remove('live');
  $('stTitle').textContent='หยุดส่งตำแหน่งแล้ว'; $('stSub').textContent='กดเริ่มวิ่งอีกครั้งเมื่อพร้อม';
  if(S.watchId!=null) navigator.geolocation.clearWatch(S.watchId);
  S.watchId=null;
  await stopWatchNative();
  try{ await S.wake?.release(); }catch(e){} S.wake=null;
  saveSession(); drawBar('scRun');
}
function onPos(p){
  S.lastPos = p;
  updateMe(p);
  const kmh = p.coords.speed!=null ? Math.max(0,p.coords.speed*3.6) : null;
  $('gSpeed').textContent = kmh!=null ? kmh.toFixed(0)+' กม./ชม.' : '—';
  $('gAcc').textContent = '±'+Math.round(p.coords.accuracy)+' ม.';
  const now = Date.now();
  if(now - S.lastSent < PING_SEC*1000) return;
  S.lastSent = now;
  /* เข้าคิวก่อนเสมอ แล้วค่อยส่ง — เน็ตหลุดหรือสลับแอปอยู่ พิกัดก็ไม่หาย
     ใส่ recorded_at เองด้วย เวลาที่บันทึกจะได้เป็นเวลาที่วิ่งจริง ไม่ใช่เวลาที่ส่งขึ้นทีหลัง */
  queuePing({
    vehicle_id:S.veh.id, trip_id:S.trip.id,
    lat:p.coords.latitude, lng:p.coords.longitude,
    speed_kmh:kmh, accuracy_m:p.coords.accuracy, heading:p.coords.heading,
    recorded_at:new Date(now).toISOString()
  });
}
/* สลับแอปแล้วกลับมา: ขอจอค้างใหม่ · เริ่ม watch ใหม่ · ส่งคิวที่ค้าง · ดึงงานล่าสุด */
document.addEventListener('visibilitychange', async ()=>{
  if(document.visibilityState==='hidden'){ S.hiddenAt = Date.now(); saveSession(); return; }
  const gap = S.hiddenAt ? Date.now()-S.hiddenAt : 0; S.hiddenAt = null;
  flushQ();
  if(S.tracking){
    if(!NATIVE){                                      // โหมดเว็บเท่านั้นที่ต้องกู้คืน
      if(!S.wake){ try{ S.wake = await navigator.wakeLock?.request('screen'); }catch(e){} }
      startWatch();
      S.lastSent = 0;                                 // ให้ยิงพิกัดทันทีที่ได้ตำแหน่งแรก
      if(gap > 60000) toast(`หยุดส่งตำแหน่งไป ${Math.round(gap/60000)} นาทีตอนสลับแอป · ต่อให้แล้ว`);
    }
  }
  if(S.trip && $('scRun').classList.contains('on')) loadStops();   // ดึงสถานะจุดส่งล่าสุด
  if(dmap) setTimeout(()=>dmap.invalidateSize(),120);
});
window.addEventListener('pagehide', saveSession);

/* ---------- Geofence ---------- */
function distM(a,b,c,d){                       // Haversine (เมตร)
  const R=6371000, r=x=>x*Math.PI/180;
  const dLa=r(c-a), dLo=r(d-b);
  const h=Math.sin(dLa/2)**2 + Math.cos(r(a))*Math.cos(r(c))*Math.sin(dLo/2)**2;
  return 2*R*Math.asin(Math.sqrt(h));
}
/* คืนค่า: ok = ส่งได้เลย | far = อยู่นอกรัศมี | nogps = ไม่มีพิกัด | nodest = จุดส่งไม่มีพิกัด */
function geoCheck(){
  const s = S.stop, p = S.lastPos?.coords;
  if(s.approval_status==='approved') return {v:'approved'};
  if(s.approval_status==='pending')  return {v:'pending'};
  if(s.approval_status==='rejected') return {v:'rejected'};
  if(!p) return {v:'nogps'};
  if(s.dest_lat==null||s.dest_lng==null) return {v:'nodest'};
  const d = distM(p.latitude, p.longitude, s.dest_lat, s.dest_lng);
  const lim = s.geofence_m ?? 300;
  return {v: d<=lim ? 'ok':'far', d:Math.round(d), lim, acc:Math.round(p.accuracy)};
}
function renderGeo(){
  const g = geoCheck(); S.geo = g;
  const box=$('geoBox'), ask=$('geoAsk');
  box.className='geo'; ask.style.display='none';
  const set=(cls,ic,t,s)=>{ box.classList.add(cls); $('geoIc').textContent=ic;
    $('geoT').textContent=t; $('geoS').innerHTML=s; };
  switch(g.v){
    case 'ok': set('ok','✓','อยู่ในพื้นที่จุดส่ง',
      `ห่างจากจุดหมาย <b>${g.d} ม.</b> · กำหนดไว้ไม่เกิน <b>${g.lim} ม.</b><br>บันทึกการส่งได้เลย`); break;
    case 'approved': set('ok','✓','ศูนย์อนุมัติแล้ว','บันทึกการส่งได้เลย'); break;
    case 'far':
      set('bad','⚠','อยู่นอกพื้นที่จุดส่ง',
        `ห่างจากจุดหมาย <b>${g.d} ม.</b> · เกินที่กำหนด <b>${g.lim} ม.</b><br>
         ความแม่นยำ GPS ±${g.acc} ม. · ต้องขออนุมัติจากศูนย์ก่อน`);
      ask.style.display='block'; break;
    case 'pending':
      set('warn','◷','รอศูนย์อนุมัติ',
        `ส่งคำขอแล้ว${S.stop.approval_distance_m?` (ห่าง <b>${Math.round(S.stop.approval_distance_m)} ม.</b>)`:''}
         <div class="wait"><span class="spin"></span>รอผลอนุมัติ หน้าจอจะอัปเดตเอง</div>`); break;
    case 'rejected':
      set('bad','✕','ศูนย์ไม่อนุมัติ',
        `${S.stop.approval_note ? esc(S.stop.approval_note)+'<br>' : ''}ติดต่อศูนย์ หรือเข้าใกล้จุดส่งแล้วลองใหม่`);
      ask.style.display='block'; break;
    case 'nogps': set('bad','⚠','ยังไม่มีพิกัด GPS',
      'กดเริ่มวิ่งเพื่อเปิดการส่งตำแหน่งก่อน แล้วรอสักครู่'); break;
    case 'nodest': set('warn','◎','จุดส่งนี้ไม่ได้ตั้งพิกัดไว้',
      'ระบบข้ามการตรวจระยะ บันทึกการส่งได้ตามปกติ'); break;
  }
  drawBar('scPod');
}
const esc = s => String(s??'').replace(/[<>&]/g,c=>({'<':'&lt;','>':'&gt;','&':'&amp;'}[c]));

window.askApproval = async () => {
  const p = S.lastPos?.coords; if(!p) return toast('ยังไม่มีพิกัด GPS',true);
  const reason = $('podReason').value.trim();
  if(!reason) return toast('ใส่เหตุผลก่อนขออนุมัติ',true);
  const {error} = await sb.from('stops').update({
    approval_status:'pending', approval_reason:reason,
    approval_distance_m:S.geo.d, approval_lat:p.latitude, approval_lng:p.longitude,
    approval_req_at:new Date().toISOString(), approval_note:null
  }).eq('id',S.stop.id);
  if(error) return toast('ส่งคำขอไม่สำเร็จ ลองอีกครั้ง',true);
  S.stop.approval_status='pending'; S.stop.approval_distance_m=S.geo.d;
  $('podReason').value=''; toast('ส่งคำขอไปที่ศูนย์แล้ว'); renderGeo();
};

/* ฟังผลอนุมัติแบบสด */
sb.channel('driver-approval')
  .on('postgres_changes',{event:'UPDATE',schema:'public',table:'stops'}, p=>{
    const n=p.new; if(!S.stop || n.id!==S.stop.id) return;
    if(n.approval_status===S.stop.approval_status) return;
    Object.assign(S.stop, n);
    if(n.approval_status==='approved') toast('ศูนย์อนุมัติแล้ว บันทึกการส่งได้เลย');
    if(n.approval_status==='rejected') toast('ศูนย์ไม่อนุมัติคำขอ',true);
    renderGeo();
  }).subscribe();

/* ---------- ยืนยันการส่ง ---------- */
window.openPod = async (stopId) => {
  const s = S.stops.find(x=>x.id===stopId); S.stop = s;
  $('podCust').textContent = s.seq+'. '+s.customer;
  $('podAddr').textContent = s.address||'';
  $('podRecv').value = s.receiver_name||''; $('podNote').value = s.note||'';
  S.items = {}; (s.items||[]).forEach(it => S.items[it.id] = {...it,
    status: it.status||'pending', qty_delivered: it.qty_delivered ?? it.qty_plan});
  const draft = LS.get('tms_pod', null);            // กู้ที่กรอกค้างไว้ก่อนสลับแอป
  if(draft && draft.stopId===s.id){
    Object.entries(draft.items||{}).forEach(([id,d])=>{ if(S.items[id]) Object.assign(S.items[id],d); });
    if(draft.recv) $('podRecv').value = draft.recv;
    if(draft.note) $('podNote').value = draft.note;
  }
  if(s.status==='pending'){
    await sb.from('stops').update({status:'arrived',arrived_at:new Date().toISOString()}).eq('id',s.id);
    s.status='arrived';
  }
  renderItems(); go('scPod'); renderGeo();
  clearInterval(S.geoTimer); S.geoTimer = setInterval(()=>{      // อัปเดตระยะสดทุก 3 วิ
    if($('scPod').classList.contains('on')) renderGeo(); else clearInterval(S.geoTimer);
  },3000);
};
function savePodDraft(){
  if(!S.stop) return;
  const items = {}; Object.values(S.items).forEach(it=>
    items[it.id] = {status:it.status, qty_delivered:it.qty_delivered});
  LS.set('tms_pod', {stopId:S.stop.id, items, recv:$('podRecv').value, note:$('podNote').value});
}
const CYCLE = {pending:'delivered', delivered:'partial', partial:'returned', returned:'delivered'};
window.cycleItem = (id) => {
  const it = S.items[id]; it.status = CYCLE[it.status]||'delivered';
  if(it.status==='delivered') it.qty_delivered = it.qty_plan;
  savePodDraft();
  if(it.status==='returned')  it.qty_delivered = 0;
  renderItems();
};
window.setQty = (id,v) => { S.items[id].qty_delivered = parseFloat(v)||0; savePodDraft(); };
function renderItems(){
  $('itemList').innerHTML = Object.values(S.items).map(it=>{
    const cls = {delivered:'ok',partial:'part',returned:'ret'}[it.status]||'';
    const mark = {delivered:'✓',partial:'~',returned:'↩'}[it.status]||'';
    return `<div class="item ${cls}">
      <div class="tick" onclick="cycleItem(${it.id})">${mark}</div>
      <div class="nm" onclick="cycleItem(${it.id})">
        <b>${it.item_name}</b><span>${it.item_code||''} · แผน ${it.qty_plan} ${it.unit||''}</span></div>
      ${it.status==='partial'
        ? `<input class="qty mono" type="number" inputmode="decimal" value="${it.qty_delivered}"
             onchange="setQty(${it.id},this.value)">`
        : `<div class="mono" style="color:var(--mute);font-size:14px">${
             it.status==='pending'?'—':it.qty_delivered+' '+(it.unit||'')}</div>`}
    </div>`;
  }).join('') || '<div class="empty">จุดนี้ไม่มีรายการสินค้า</div>';
}

async function savePod(){
  const g = geoCheck();
  if(g.v==='far')      return toast('อยู่นอกพื้นที่จุดส่ง ต้องขออนุมัติจากศูนย์ก่อน',true);
  if(g.v==='pending')  return toast('กำลังรอศูนย์อนุมัติ',true);
  if(g.v==='rejected') return toast('ศูนย์ไม่อนุมัติ ติดต่อศูนย์หรือเข้าใกล้จุดส่งแล้วขอใหม่',true);
  if(g.v==='nogps')    return toast('ยังไม่มีพิกัด GPS กดเริ่มวิ่งก่อน',true);
  const list = Object.values(S.items);
  if(list.some(i=>i.status==='pending')) return toast('ยังมีสินค้าที่ยังไม่ระบุสถานะ',true);
  const all = list.every(i=>i.status==='delivered');
  const none = list.length && list.every(i=>i.status==='returned');
  const stopStatus = none ? 'returned' : (all ? 'delivered' : 'partial');
  const p = S.lastPos?.coords;

  for(const it of list){
    await sb.from('items').update({status:it.status, qty_delivered:it.qty_delivered}).eq('id',it.id);
  }
  const {error} = await sb.from('stops').update({
    status:stopStatus, done_at:new Date().toISOString(),
    done_lat:p?.latitude ?? null, done_lng:p?.longitude ?? null,
    receiver_name:$('podRecv').value||null, note:$('podNote').value||null
  }).eq('id',S.stop.id);
  if(error) return toast('บันทึกไม่สำเร็จ ลองอีกครั้ง',true);
  LS.del('tms_pod');
  toast('บันทึกการส่งเรียบร้อย');
  await loadStops(); go('scRun');
}

async function endTrip(){
  if(S.stops.some(s=>s.status==='pending'||s.status==='arrived'))
    if(!confirm('ยังมีจุดส่งที่ยังไม่ยืนยัน จบเที่ยวเลยหรือไม่?')) return;
  await stopTracking();
  await sb.from('trips').update({status:'done',ended_at:new Date().toISOString()}).eq('id',S.trip.id);
  LS.del('tms_session'); LS.del('tms_pod');
  toast('จบเที่ยวเรียบร้อย'); loadTrips();
}

/* ---------- แถบปุ่มล่าง ---------- */
function drawBar(screen){
  const b = $('barInner');
  if(screen==='scLogin'||screen==='scTrips'){ $('bar').style.display='none'; return; }
  $('bar').style.display='block';
  if(screen==='scPod'){
    const v = S.geo?.v;
    const blocked = ['far','pending','rejected','nogps'].includes(v);
    const txt = {far:'ต้องขออนุมัติก่อนบันทึก', pending:'รอศูนย์อนุมัติ…',
                 rejected:'ศูนย์ไม่อนุมัติ', nogps:'ยังไม่มีพิกัด GPS'}[v] || 'บันทึกการส่ง';
    b.innerHTML = blocked
      ? `<button class="btn-ghost" style="opacity:.55" onclick="savePod()">${txt}</button>`
      : `<button class="btn-live" onclick="savePod()">บันทึกการส่ง</button>`;
  } else {
    b.innerHTML = S.tracking
      ? `<div class="row"><button class="btn-stop" onclick="stopTracking()">หยุดส่งตำแหน่ง</button>
         <button class="btn-ghost" onclick="endTrip()">จบเที่ยว</button></div>`
      : `<button class="btn" onclick="startTracking()">เริ่มวิ่ง · ส่งตำแหน่ง</button>`;
  }
}
setTheme(theme(), false);          // ตั้งไอคอนปุ่มธีม (พื้นแผนที่ตั้งตอน initMap)
window.savePod=savePod; window.startTracking=startTracking;
window.stopTracking=stopTracking; window.endTrip=endTrip; window.go=go;
</script>
