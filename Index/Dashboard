/* ============================================================
   เส้นทางตามถนนจริง (แบบ Grab) — ORS → OSRM → เส้นตรง
   ขอครั้งเดียวต่อชุดพิกัด แล้วเก็บแคชไว้ ไม่ยิงซ้ำทุกครั้งที่รีเฟรช
   ============================================================ */
const ORS_KEY = 'eyJvcmciOiI1YjNjZTM1OTc4NTExMTAwMDFjZjYyNDgiLCJpZCI6ImFlMTdkODVlNDIxMjRkZmE4ZjE2MTgxOWNiNTQ2YmNiIiwiaCI6Im11cm11cjY0In0=';
let orsDown = 0;
const RCACHE = new Map(), RPEND = new Set();
const rkey = pts => pts.map(p=>p[0].toFixed(5)+','+p[1].toFixed(5)).join(';');

async function orsRoute(pts){
  if(!ORS_KEY || Date.now()-orsDown < 600000) return null;
  try{
    const r = await fetch('https://api.openrouteservice.org/v2/directions/driving-car/geojson',{
      method:'POST', headers:{'Authorization':ORS_KEY,'Content-Type':'application/json'},
      body: JSON.stringify({coordinates: pts.map(p=>[p[1],p[0]])})});
    if(!r.ok){ if(r.status===403||r.status===429) orsDown=Date.now(); return null; }
    const j = await r.json(), f = j.features?.[0]; if(!f) return null;
    const s = f.properties?.summary || {};
    return {ll:f.geometry.coordinates.map(c=>[c[1],c[0]]), dist:s.distance, dur:s.duration, src:'ORS'};
  }catch(e){ return null; }
}
async function osrmRoute(pts){
  try{
    const u = `https://router.project-osrm.org/route/v1/driving/${pts.map(p=>p[1]+','+p[0]).join(';')}`
      + `?overview=full&geometries=geojson`;
    const r = await fetch(u); if(!r.ok) return null;
    const j = await r.json(), rt = j.routes?.[0]; if(!rt) return null;
    return {ll:rt.geometry.coordinates.map(c=>[c[1],c[0]]), dist:rt.distance, dur:rt.duration, src:'OSRM'};
  }catch(e){ return null; }
}
/* คืนเส้นถนนถ้ามีในแคช · ถ้ายังไม่มีก็คืนเส้นตรงไปก่อน แล้ววาดใหม่เมื่อเส้นถนนมาถึง */
function road(pts){
  if(pts.length<2) return {ll:pts, dist:null, dur:null, src:'LINE'};
  const k = rkey(pts);
  if(RCACHE.has(k)) return RCACHE.get(k);
  if(!RPEND.has(k)){
    RPEND.add(k);
    (async()=>{
      const r = await orsRoute(pts) || await osrmRoute(pts) || {ll:pts, dist:null, dur:null, src:'LINE'};
      if(RCACHE.size > 250) RCACHE.clear();
      RCACHE.set(k,r); RPEND.delete(k); drawNetwork();
    })();
  }
  return {ll:pts, dist:null, dur:null, src:'WAIT'};
}
function vstate(p){
  if(!p || p.age_sec > OFFLINE_SEC) return 'off';
  return (p.speed_kmh||0) > 3 ? 'moving' : 'idle';
}
function bearing(a,b){
  const toR=x=>x*Math.PI/180, toD=x=>x*180/Math.PI;
  const dL=toR(b[1]-a[1]), y=Math.sin(dL)*Math.cos(toR(b[0]));
  const x=Math.cos(toR(a[0]))*Math.sin(toR(b[0]))-Math.sin(toR(a[0]))*Math.cos(toR(b[0]))*Math.cos(dL);
  return (toD(Math.atan2(y,x))+360)%360;
}

/* ---------- เครื่องยนต์ animation: หมุดไหลจากจุดเดิมไปจุดใหม่ ---------- */
const ANIM_MS = 3000;                 // เวลาไหลต่อ 1 ping
function animateMarker(v, to){
  if(!v.marker){ return; }
  const from = v.marker.getLatLng();
  if(v._raf) cancelAnimationFrame(v._raf);
  const t0 = performance.now();
  const step = now => {
    const k = Math.min(1,(now-t0)/ANIM_MS);
    const e = k<0.5 ? 2*k*k : 1-Math.pow(-2*k+2,2)/2;   // easeInOut
    const lat = from.lat+(to[0]-from.lat)*e, lng = from.lng+(to[1]-from.lng)*e;
    v.marker.setLatLng([lat,lng]);
    if(FOLLOW && sel===v.row.id) map.panTo([lat,lng],{animate:false});
    if(k<1) v._raf = requestAnimationFrame(step);
  };
  v._raf = requestAnimationFrame(step);
}

