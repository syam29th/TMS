/* ---------- ตรงเวลา / เลยเวลา ----------
   eta = เวลาที่ควรถึงตามแผน (มาจาก planner) · เทียบกับเวลาที่กดยืนยันจริง ถ้ายังไม่ส่งก็เทียบกับตอนนี้ */
const LATE_MIN = 15;                       // เกินกี่นาทีถึงนับว่าสาย
function etaDate(s){
  if(!s?.eta) return null;
  const [h,m] = String(s.eta).split(':');
  const d = new Date(); d.setHours(+h, +m, 0, 0); return d;
}
function lateMin(s){
  const e = etaDate(s); if(!e) return null;
  const ref = s.done_at ? new Date(s.done_at) : new Date();
  return Math.round((ref - e)/60000);
}
const lateTxt = m => m>=60 ? `${(m/60).toFixed(1)} ชม.` : `${m} น.`;
function lateChip(s){
  const m = lateMin(s); if(m==null) return '';
  if(m > LATE_MIN)  return `<span class="chipx late">สาย ${lateTxt(m)}</span>`;
  if(isDone(s))     return `<span class="chipx ${m < -5 ? 'early':'ontime'}">${
                              m < -5 ? 'เร็วกว่าแผน '+lateTxt(-m) : 'ตรงเวลา'}</span>`;
  return '';
}

function renderKpi(){
  const vs = Object.values(V), st = vs.map(v=>vstate(v.pos));
  $('kRun').textContent  = st.filter(x=>x==='moving').length;
  $('kIdle').textContent = st.filter(x=>x==='idle').length;
  $('kOff').textContent  = st.filter(x=>x==='off').length;
  let done=0, left=0, late=0, onTime=0, rated=0;
  vs.forEach(v=>(v.trip?.stops||[]).forEach(s=>{
    const m = lateMin(s);
    if(isDone(s)){ done++; if(m!=null){ rated++; if(m<=LATE_MIN) onTime++; else late++; } }
    else { left++; if(m!=null && m>LATE_MIN) late++; }
  }));
  $('kDone').textContent=done; $('kLeft').textContent=left; $('kLate').textContent=late;
  $('kLateBox').classList.toggle('bad', late>0);
  /* แถบ on-time — ตัวเลขที่ผู้บริหารถามทุกวัน */
  if(rated){
    const pct = Math.round(onTime/rated*100);
    $('otBar').style.display='flex';
    $('otFill').style.width = pct+'%';
    $('otTxt').textContent = `ส่งตรงเวลา ${pct}%  (${onTime}/${rated} จุด)`;
  } else $('otBar').style.display='none';
}

function railHtml(stops){
  if(!stops||!stops.length) return '<div style="font-size:11px;color:var(--dim);margin-top:8px">ไม่มีเที่ยววันนี้</div>';
  const k = s => ({delivered:'done',partial:'partial',returned:'ret',arrived:'arrived'})[s.status]||'';
  return '<div class="rail">' + stops.map((s,i)=>
    `<div class="bead ${k(s)}" title="${s.customer}">${k(s)==='done'?'✓':s.seq}</div>` +
    (i<stops.length-1 ? `<div class="seg ${k(s)&&k(s)!=='arrived'?'done':''}"></div>`:'')
  ).join('') + '</div>';
}

const VORDER = {moving:0, idle:1, off:2};
function vehLate(v){ const nx = nextStopOf(v); const m = nx ? lateMin(nx) : null; return m==null?-999:m; }
function renderVeh(){
  /* เรียง: กำลังวิ่ง → จอด → ขาดสัญญาณ · ในกลุ่มเดียวกันเอาคันที่สายที่สุดขึ้นก่อน */
  const list = Object.values(V).sort((a,b)=>
    (VORDER[vstate(a.pos)] - VORDER[vstate(b.pos)]) || (vehLate(b) - vehLate(a))
    || String(a.row.id).localeCompare(String(b.row.id)));
  $('vehList').innerHTML = list.map(v=>{
    const st = vstate(v.pos), stops = v.trip?.stops||[];
    const done = stops.filter(s=>['delivered','partial','returned'].includes(s.status)).length;
    return `<div class="veh ${sel===v.row.id?'sel':''}" onclick="pick('${v.row.id}')">
      <div class="hd">
        <div><div class="plate"><span class="vchip" style="background:${vcolor[v.row.id]||'#4A5F7D'}"></span>${v.row.plate}</div>
        <div class="drv">${v.row.driver_name||'—'}</div></div>
        <div class="st ${st}">${STXT[st]}</div>
      </div>
      ${railHtml(stops)}
      <div class="meta">
        <span>${stops.length?`ส่งแล้ว ${done}/${stops.length}`:'—'}</span>
        ${(()=>{ const nx=nextStopOf(v), m=nx?lateMin(nx):null;
          return (m!=null && m>LATE_MIN) ? `<span class="chipx late">สาย ${lateTxt(m)}</span>`
               : (nx && m!=null ? `<span class="chipx ontime">ตามแผน</span>` : ''); })()}
        <span class="mono">${v.trip?.plan_distance_m? 'แผน '+(v.trip.plan_distance_m/1000).toFixed(1)+' กม.' : (v.pos? Math.round(v.pos.speed_kmh||0)+' กม./ชม.':'—')}</span>
        <span class="mono">${v.pos? 'อัปเดต '+hhmm(v.pos.recorded_at):'ไม่มีสัญญาณ'}</span>
      </div></div>`;
  }).join('');
}

function renderMarkers(){
