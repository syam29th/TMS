/* ============================================================
   เส้นทางแผน + จุดส่งทั้งหมดบนแผนที่
   เส้นประ = ลำดับส่งตามแผน (คลัง → จุด 1 → 2 → … [→ กลับคลัง])
   หมุดกลม = จุดส่ง สีในหมุด = สถานะ · ขอบหมุด = สีประจำรถ
   เลือกรถคันใดคันหนึ่ง = คันอื่นจางลง แต่ยังเห็นภาพรวม
   ============================================================ */
const SCOLOR = {delivered:'#2FD3B8', partial:'#F5A524', returned:'#E5544B',
                arrived:'#F5A524', pending:'#56708F'};
const kmTxt = m => m!=null ? (m/1000).toFixed(1)+' กม.' : null;

function drawNetwork(){
  routeLayer.clearLayers(); pastLayer.clearLayers();
  allLayer.clearLayers(); depotLayer.clearLayers();
  const depots = new Map(), bounds = [];

  Object.values(V).forEach(v=>{
    const t = v.trip; if(!t) return;
    const col = vcolor[v.row.id] || '#8A9CB4';
    const focus = !sel || sel===v.row.id;
    const op = focus ? 1 : .3;
    const stops = (t.stops||[]).filter(s=>s.dest_lat!=null && s.dest_lng!=null);
    if(t.origin_lat!=null && t.origin_lng!=null)
      depots.set(t.origin_lat.toFixed(5)+','+t.origin_lng.toFixed(5),
        {lat:t.origin_lat, lng:t.origin_lng, name:t.origin_name});

    if(SHOW.route) drawRoute(v, focus, op, bounds);

    if(SHOW.stops) stops.forEach(s=>{
      const c = SCOLOR[s.status] || SCOLOR.pending;
      const done = isDone(s);
      bounds.push([s.dest_lat, s.dest_lng]);
      L.marker([s.dest_lat,s.dest_lng],{zIndexOffset: focus?200:0,
        icon: boxIcon(c, col, done?'✓':s.seq, op)})
        .addTo(allLayer)
        .bindPopup(`<b>${esc(s.customer)}</b><br>
          ${esc(v.row.plate)} · จุดที่ ${s.seq} · ${ST[s.status]||s.status}
          ${s.address?'<br><span style="color:#8A9CB4">'+esc(s.address)+'</span>':''}
          ${s.eta?`<br>ถึงตามแผน ${String(s.eta).slice(0,5)} น.`:''}
          ${s.leg_distance_m?` · ${kmTxt(s.leg_distance_m)} จากจุดก่อนหน้า`:''}
          ${s.done_at?`<br><span style="color:#2FD3B8">ยืนยัน ${hhmm(s.done_at)}</span>`:''}
          <br>${(s.items||[]).length} รายการ`)
        .on('click',()=>{ if(sel!==v.row.id) pick(v.row.id); });

      /* จุดที่คนขับกดยืนยันห่างจากจุดส่งเกิน 100 ม. — โยงเส้นให้เห็น (เฉพาะคันที่เลือก) */
      if(focus && sel && s.done_lat!=null && distM(s.done_lat,s.done_lng,s.dest_lat,s.dest_lng)>100){
        L.polyline([[s.dest_lat,s.dest_lng],[s.done_lat,s.done_lng]],
          {color:'#E5544B',weight:1.5,dashArray:'4 4',opacity:.9}).addTo(allLayer);
        L.circleMarker([s.done_lat,s.done_lng],{radius:5,color:'#E5544B',fillColor:'#E5544B',
          fillOpacity:.9,weight:1}).addTo(allLayer)
          .bindPopup(`<b>จุดที่กดยืนยันจริง</b><br>${esc(s.customer)}<br>
            ห่างจากจุดส่ง ${Math.round(distM(s.done_lat,s.done_lng,s.dest_lat,s.dest_lng))} ม.`);
      }
    });
  });

  /* เส้นที่วิ่งมาแล้ว — เฉพาะคันที่เลือก (ดึงทั้งวันมาเส้นเดียว) */
  if(SHOW.past && sel && (PAST[sel]||[]).length>1){
    L.polyline(PAST[sel],{color:'var(--map-bg)',weight:7,opacity:.3,
      lineCap:'round',lineJoin:'round'}).addTo(pastLayer);
    L.polyline(PAST[sel],{color:RT_PAST,weight:3.5,opacity:.85,
      lineCap:'round',lineJoin:'round'}).addTo(pastLayer)
      .bindPopup(`<b>${esc(V[sel].row.plate)}</b><br>เส้นที่วิ่งมาแล้ววันนี้`);
    PAST[sel].forEach(p=>bounds.push(p));
  }

  depots.forEach(d=>{
    bounds.push([d.lat,d.lng]);
    L.marker([d.lat,d.lng],{icon:depotIcon(), zIndexOffset:150})
      .addTo(depotLayer).bindPopup(`<b>จุดรับสินค้า</b><br>${esc(d.name||'—')}`);
  });

  NET_BOUNDS = bounds;
  renderLegend();
  if(!didFit && bounds.length){ didFit = true; fitAll(); }
}
let NET_BOUNDS = [];

/* ============================================================
   เส้นทางที่ "ยังต้องวิ่ง" — เส้นเดียวจบ ไม่มีเส้นแผนซ้อนกับเส้นกำลังวิ่ง
     ยังไม่ออกรถ / ไม่มีสัญญาณ → เริ่มจากคลัง ผ่านจุดที่ยังไม่ส่งตามลำดับ
     กำลังวิ่ง                → เริ่มจากตำแหน่งรถจริงตอนนี้ (จุดที่ส่งแล้วตัดออก)
   ช่วงแรก (ไปจุดถัดไป) วาดหนา+ไหล พร้อมป้ายเวลา/ระยะ · ช่วงที่เหลือบางลง
   ปัดพิกัดรถเป็นทศนิยม 3 ตำแหน่ง (~110 ม.) ก่อนใช้เป็นคีย์แคช จะได้ไม่ยิงขอทุก ping
   ============================================================ */
const snap3 = x => +x.toFixed(3);
const isDone = s => ['delivered','partial','returned'].includes(s.status);
function nextStopOf(v){
  return (v.trip?.stops||[]).find(s=>!isDone(s) && s.dest_lat!=null && s.dest_lng!=null);
}
function drawRoute(v, focus, op, bounds){
  const t = v.trip;
  const pend = (t.stops||[]).filter(s=>!isDone(s) && s.dest_lat!=null && s.dest_lng!=null);
  const live = v.pos && vstate(v.pos)!=='off' && t.status==='running';
  const head = live ? [snap3(v.pos.lat), snap3(v.pos.lng)]
             : (t.origin_lat!=null ? [t.origin_lat, t.origin_lng] : null);
  if(!head) return;
  const rest = pend.map(s=>[s.dest_lat, s.dest_lng]);
  if(t.plan_return && t.origin_lat!=null) rest.push([t.origin_lat, t.origin_lng]);
  if(!rest.length) return;
  rest.forEach(p=>bounds.push(p)); bounds.push(head);

  /* ช่วงแรก: หัวเส้น → จุดถัดไป (เส้นเด่น) */
  const leg1 = road([head, rest[0]]);
  const ll1  = live ? [[v.pos.lat, v.pos.lng], ...leg1.ll] : leg1.ll;
  const col = vcolor[v.row.id] || '#F5A524';
  const lines = [paintRoute(ll1, focus?6:3, focus?.97:op*.75, focus && live, col)];  // ไหล = กำลังวิ่งจริงเท่านั้น
  /* ช่วงที่เหลือ: จุดถัดไป → จุดอื่น ๆ จนจบ (เส้นบางกว่า ไม่ไหล) */
  if(rest.length>1){
    const rt2 = road(rest);
    lines.push(paintRoute(rt2.ll, focus?3.5:2, (focus?.75:op*.5), false, col));
  }
  /* ป้ายบอกเวลา/ระยะช่วงที่กำลังวิ่ง — เฉพาะคันที่เลือก */
  if(sel===v.row.id && live){
    const nx = pend[0];
    const mid = ll1[Math.floor(ll1.length/2)];
    const txt = leg1.dur!=null
      ? `${esc(nx?nx.customer:'')} · ${Math.max(1,Math.round(leg1.dur/60))} นาที · <span class="km">${
          leg1.dist>=1000 ? (leg1.dist/1000).toFixed(1)+' กม.' : Math.round(leg1.dist)+' ม.'}</span>`
      : 'กำลังหาเส้นทาง…';
    L.marker(mid,{interactive:false, zIndexOffset:400,
      icon:L.divIcon({className:'', iconSize:[0,0], html:`<div class="chip">${txt}</div>`})})
      .addTo(routeLayer);
  }
  const pop = `<b>${esc(v.row.plate)}</b><br>เที่ยว #${t.id} · เหลือ ${pend.length} จาก ${(t.stops||[]).length} จุด`
    + (t.plan_distance_m?`<br>ทั้งเที่ยวตามแผน ${kmTxt(t.plan_distance_m)} · ${Math.round(t.plan_duration_s/60)} นาที`:'')
    + (t.route_mode==='auto'?'<br><span style="color:#2FD3B8">จัดลำดับอัตโนมัติ</span>':'');
  lines.forEach(l=>l.bindPopup(pop).on('click',()=>{ if(sel!==v.row.id) pick(v.row.id); }));
}
/* เงาใต้เส้น + เส้นสีเขียวข้างบน (อ่านง่ายทั้งบนถนนสีอ่อนและสวนสีเขียว) */
function paintRoute(ll, w, opacity, flowing, col){
  L.polyline(ll,{color:'var(--map-bg)', weight:w+5, opacity:opacity*.4,
    lineCap:'round', lineJoin:'round'}).addTo(routeLayer);
  return L.polyline(ll,{color:col, weight:w, opacity:opacity,
    lineCap:'round', lineJoin:'round', className: flowing?'flow':''}).addTo(routeLayer);
}
function distM(la1,ln1,la2,ln2){
  const r=Math.PI/180, dLa=(la2-la1)*r, dLn=(ln2-ln1)*r;
  const x=Math.sin(dLa/2)**2+Math.cos(la1*r)*Math.cos(la2*r)*Math.sin(dLn/2)**2;
  return 6371000*2*Math.atan2(Math.sqrt(x),Math.sqrt(1-x));
}
window.fitAll = () => {
  const pts = NET_BOUNDS.concat(Object.values(V).filter(v=>v.pos).map(v=>[v.pos.lat,v.pos.lng]));
  if(!pts.length) return;
  setFollow(false);
  map.fitBounds(L.latLngBounds(pts).pad(.18));
};
window.tg = k => { SHOW[k] = !SHOW[k];
  $({stops:'tgStops', route:'tgRoute', past:'tgPast'}[k]).classList.toggle('on', SHOW[k]);
  drawNetwork(); };

function renderLegend(){
  const rows = Object.values(V).filter(v=>v.trip && (v.trip.stops||[]).length);
  if(!rows.length){ $('legend').style.display='none'; return; }
  $('legend').style.display='block';
  $('legend').innerHTML = `<div class="h">เส้นทางวันนี้</div>` + rows.map(v=>{
    const st=(v.trip.stops||[]), done=st.filter(s=>['delivered','partial','returned'].includes(s.status)).length;
    return `<div class="r ${sel&&sel!==v.row.id?'dim':''}" style="color:${vcolor[v.row.id]}"
        onclick="pick('${v.row.id}')">
      <span class="ln"></span><span class="plate" style="color:var(--paper)">${esc(v.row.plate)}</span>
      <span class="n">${done}/${st.length}</span></div>`;
  }).join('') + `<div class="foot">
    เส้นสีประจำรถ = ทางที่ยังต้องวิ่ง (ช่วงไปจุดถัดไปหนาและไหล)<br>
    <span style="color:${RT_PAST}">━</span> เส้นเทา = ทางที่วิ่งมาแล้ววันนี้<br>
    หมุดกล่อง: <span style="color:#56708F">รอส่ง</span> ·
    <span style="color:#F5A524">บางส่วน</span> ·
    <span style="color:#2FD3B8">ส่งครบ</span> ·
    <span style="color:#E5544B">ตีกลับ</span></div>`;
}

/* ---------- แผงรายละเอียด ---------- */
let FOLLOW = false;
window.pick = (id) => {
  sel = id; $('main').classList.add('detail'); $('detail').classList.add('on');
  renderVeh(); renderDetail();
  const v = V[id];
  drawNetwork(); loadPast(id);
  /* ซูมให้เห็นทั้งเส้นทางของคันนี้ ไม่ใช่แค่ตำแหน่งรถ */
  const pts = (v.trip?.stops||[]).filter(s=>s.dest_lat!=null).map(s=>[s.dest_lat,s.dest_lng]);
  if(v.trip?.origin_lat!=null) pts.push([v.trip.origin_lat, v.trip.origin_lng]);
  if(v.pos) pts.push([v.pos.lat, v.pos.lng]);
  if(pts.length>1) map.fitBounds(L.latLngBounds(pts).pad(.22));
  else if(v.pos) map.setView([v.pos.lat,v.pos.lng], 15);
};
window.closeDetail = () => { setFollow(false);
  sel=null; $('main').classList.remove('detail');
  $('detail').classList.remove('on'); renderVeh(); drawNetwork(); };
function setFollow(on){ FOLLOW = on;
  const b = $('bFollow'); if(!b) return;
  b.classList.toggle('on', on); b.textContent = on ? 'กำลังตามรถ · กดเพื่อหยุด' : 'ตามรถคันนี้';
  if(on && V[sel]?.pos) map.setView([V[sel].pos.lat, V[sel].pos.lng], 16);
}
window.toggleFollow = () => setFollow(!FOLLOW);
/* ผู้ใช้ลากแผนที่เอง = ต้องการดูที่อื่น หยุดตามให้อัตโนมัติ */
map.on('dragstart', ()=> FOLLOW && setFollow(false));

function renderDetail(){
  const v = V[sel]; if(!v) return;
  $('dPlate').textContent = v.row.plate;
  $('dDrv').textContent = (v.row.driver_name||'—') + (v.trip? ` · เที่ยว #${v.trip.id}`:'');
  const stops = v.trip?.stops||[];
  $('dStops').innerHTML = stops.length ? stops.map(s=>`
    <div class="stop ${s.status}">
      <div style="display:flex;justify-content:space-between;gap:8px">
        <div><div class="cust">${s.seq}. ${s.customer}</div>
        <div class="sub">${s.address||''}</div></div>
        <div class="sub s ${s.status}" style="white-space:nowrap">${ST[s.status]}</div>
      </div>
      ${s.eta?`<div class="sub mono" style="margin-top:5px;display:flex;gap:7px;align-items:center;flex-wrap:wrap">
        <span>ตามแผน ${String(s.eta).slice(0,5)} น.${s.leg_distance_m?' · '+(s.leg_distance_m/1000).toFixed(1)+' กม.':''}</span>
        ${lateChip(s)}</div>`:''}
      ${s.done_at?`<div class="sub mono" style="margin-top:4px">ยืนยัน ${hhmm(s.done_at)}${s.receiver_name?' · ผู้รับ '+s.receiver_name:''}</div>`:''}
      <div style="margin-top:8px">${(s.items||[]).map(i=>`
        <div class="itm"><span>${i.item_name}</span>
        <span class="s ${i.status||'pending'}">${i.qty_delivered ?? '–'}/${i.qty_plan} ${i.unit||''}</span></div>`).join('')}</div>
      ${s.note?`<div class="sub" style="margin-top:6px">หมายเหตุ: ${s.note}</div>`:''}
    </div>`).join('') : '<div class="empty">รถคันนี้ยังไม่มีเที่ยววิ่งของวันนี้</div>';
}

/* ---------- ส่งออก CSV ---------- */
window.exportCsv = () => {
  const v = V[sel]; const rows = [['ทะเบียน','คนขับ','เที่ยว','ลำดับ','ลูกค้า','สถานะจุดส่ง','เวลายืนยัน','ผู้รับ','สินค้า','แผน','ส่งจริง','หน่วย','สถานะสินค้า']];
  (v.trip?.stops||[]).forEach(s=>(s.items||[]).forEach(i=>rows.push([
    v.row.plate, v.row.driver_name||'', v.trip.id, s.seq, s.customer, ST[s.status],
    s.done_at?hhmm(s.done_at):'', s.receiver_name||'', i.item_name, i.qty_plan,
    i.qty_delivered ?? '', i.unit||'', ST[i.status]||i.status])));
  const csv = '\uFEFF' + rows.map(r=>r.map(c=>`"${String(c).replace(/"/g,'""')}"`).join(',')).join('\n');
  const a = document.createElement('a');
  a.href = URL.createObjectURL(new Blob([csv],{type:'text/csv'}));
  a.download = `TMS_${v.row.plate}_${today()}.csv`; a.click();
};

/* ---------- Realtime ---------- */
sb.channel('tms')
  .on('postgres_changes',{event:'INSERT',schema:'public',table:'gps_logs'}, p=>{
    const g = p.new, v = V[g.vehicle_id]; if(!v) return;
    const prev = v.pos ? [v.pos.lat, v.pos.lng] : null;
    v.pos = {...g, age_sec:0};
    /* ทิศทาง: ใช้ heading จาก GPS ก่อน ถ้าไม่มีคำนวณจากจุดก่อนหน้า */
    if(g.heading!=null) v.heading = g.heading;
    else if(prev && (prev[0]!==g.lat||prev[1]!==g.lng)) v.heading = bearing(prev,[g.lat,g.lng]);
    if(PAST[g.vehicle_id]) PAST[g.vehicle_id].push([g.lat,g.lng]);
    renderMarkers(); renderVeh(); renderKpi();
    if(sel===g.vehicle_id) drawNetwork();
  })
  .on('postgres_changes',{event:'*',schema:'public',table:'stops'}, ()=>{ loadAll(); loadAppr(); })
  .subscribe();

loadAll(); loadAppr();
setInterval(()=>{ loadAll(); loadAppr(); }, 60000);   // sync เต็มทุก 1 นาที กันหลุด
</script>
