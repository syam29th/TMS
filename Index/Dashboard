<!DOCTYPE html>
<html lang="th">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>TMS · ศูนย์ควบคุมการขนส่ง</title>
<script>/* ตั้งธีมก่อนวาดหน้า กันจอกระพริบตอนโหลด */
try{var _t=localStorage.getItem('tms_theme')||(matchMedia('(prefers-color-scheme: light)').matches?'light':'dark');
document.documentElement.dataset.theme=_t;}catch(e){document.documentElement.dataset.theme='dark';}</script>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Anuphan:wght@500;700&family=IBM+Plex+Sans+Thai:wght@400;500;600&family=IBM+Plex+Mono:wght@500&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css">
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
<style>
/* ============================================================
   ธีม — มืด (ค่าเริ่มต้นตามเครื่อง) / สว่าง · สลับที่ปุ่มมุมขวาบน จำค่าไว้ในเครื่อง
   โหมดมืด = ใช้ในห้องคุมกลางคืน · โหมดสว่าง = ใช้ในออฟฟิศ/กลางแดด
   ============================================================ */
:root{
  --ink:#0E1520; --panel:#141D2A; --panel2:#1B2636; --line:#26344A;
  --paper:#E6EDF5; --mute:#8A9CB4;
  --signal:#F5A524; --live:#2FD3B8; --alert:#E5544B; --dim:#4A5F7D;
  --on-signal:#12161C; --on-live:#0B1F1B; --on-alert:#FFFFFF;
  --hint-t:#F2D9A8; --map-bg:var(--map-bg);
  --shadow:0 6px 22px rgba(0,0,0,.42);
  color-scheme:dark;
}
:root[data-theme="light"]{
  --ink:#E9EEF5; --panel:#FFFFFF; --panel2:#F2F6FB; --line:#D2DCEA;
  --paper:#132030; --mute:#566780;
  --signal:#BE7009; --live:#0B8C79; --alert:#BC3A30; --dim:#8DA0B7;
  --on-signal:#FFFFFF; --on-live:#FFFFFF; --on-alert:#FFFFFF;
  --hint-t:#7A4A05; --map-bg:#E4EAF1;
  --shadow:0 6px 20px rgba(23,42,71,.14);
  color-scheme:light;
}
.thm{background:transparent;border:1px solid var(--line);color:var(--mute);border-radius:9px;
  padding:7px 9px;cursor:pointer;display:grid;place-items:center;line-height:0;width:auto;flex:none}
.thm:hover{color:var(--signal);border-color:var(--signal)}
.thm svg{width:16px;height:16px;display:block}
*{box-sizing:border-box}
html,body{margin:0;height:100%;background:var(--ink);color:var(--paper);
  font-family:'IBM Plex Sans Thai',system-ui,sans-serif;font-size:14px;overflow:hidden}
h1,h2,h3,.disp{font-family:'Anuphan',sans-serif;font-weight:700;margin:0}
.mono{font-family:'IBM Plex Mono',monospace;font-variant-numeric:tabular-nums}

.app{display:grid;grid-template-rows:56px 1fr;height:100%}
.top{display:flex;align-items:center;gap:16px;padding:0 20px;border-bottom:1px solid var(--line);background:var(--panel)}
.top h1{font-size:17px;letter-spacing:.02em}
.top .tag{font-size:11px;letter-spacing:.16em;text-transform:uppercase;color:var(--signal)}
.top .right{margin-left:auto;display:flex;align-items:center;gap:18px;color:var(--mute);font-size:12px}
.dot{width:8px;height:8px;border-radius:50%;background:var(--live);display:inline-block;margin-right:6px}

.main{display:grid;grid-template-columns:340px 1fr 0;min-height:0;transition:grid-template-columns .22s}
.main.detail{grid-template-columns:340px 1fr 380px}
@media(max-width:1100px){.main,.main.detail{grid-template-columns:280px 1fr}
  .side.detail{position:absolute;right:0;top:56px;bottom:0;width:340px;z-index:500}}

.side{border-right:1px solid var(--line);background:var(--panel);overflow-y:auto;min-height:0}
.side.detail{border-right:0;border-left:1px solid var(--line);overflow-x:hidden}
.side.detail:not(.on){display:none}
#map{height:100%;background:var(--map-bg)}

.sec{padding:14px 16px;border-bottom:1px solid var(--line)}
.lbl{font-size:11px;letter-spacing:.16em;text-transform:uppercase;color:var(--mute);margin-bottom:10px}
.kpis{display:grid;grid-template-columns:repeat(3,1fr);gap:8px}
.kpi{background:var(--panel2);border:1px solid var(--line);border-radius:10px;padding:10px}
.kpi b{display:block;font-family:'IBM Plex Mono',monospace;font-size:20px;font-weight:500;line-height:1.2}
.kpi span{font-size:11px;color:var(--mute)}

/* vehicle card — rail is the signature */
.veh{padding:13px 16px;border-bottom:1px solid var(--line);cursor:pointer;border-left:3px solid transparent}
.veh:hover{background:var(--panel2)}
.veh.sel{background:var(--panel2);border-left-color:var(--signal)}
.veh .hd{display:flex;justify-content:space-between;align-items:baseline;gap:8px}
.veh .plate{font-family:'IBM Plex Mono',monospace;font-size:14px}
.veh .drv{font-size:12px;color:var(--mute)}
.veh .st{font-size:11px;letter-spacing:.08em;text-transform:uppercase}
.st.moving{color:var(--live)} .st.idle{color:var(--signal)} .st.off{color:var(--dim)}
.rail{display:flex;align-items:center;margin-top:10px}
.bead{flex:none;width:18px;height:18px;border-radius:50%;border:2px solid var(--dim);background:var(--ink);
  display:grid;place-items:center;font-size:9px;font-weight:600;color:var(--mute)}
.bead.done{background:var(--live);border-color:var(--live);color:var(--on-live)}
.bead.partial{background:var(--signal);border-color:var(--signal);color:var(--on-signal)}
.bead.ret{background:var(--alert);border-color:var(--alert);color:#fff}
.bead.arrived{border-color:var(--signal);box-shadow:0 0 0 3px rgba(245,165,36,.18)}
.seg{flex:1;height:2px;background:var(--dim)} .seg.done{background:var(--live)}
.veh .meta{display:flex;gap:9px 14px;margin-top:8px;font-size:11px;color:var(--mute);
  flex-wrap:wrap;align-items:center}
/* ตัวชี้วัดตรงเวลา — หัวใจของงานขนส่ง */
.kpi.bad b{color:var(--alert)}
.otbar{margin-top:9px;height:20px;border-radius:99px;background:var(--panel2);border:1px solid var(--line);
  position:relative;overflow:hidden;display:flex;align-items:center}
.otfill{position:absolute;left:0;top:0;bottom:0;background:linear-gradient(90deg,var(--live),color-mix(in srgb,var(--live) 55%, var(--signal)));opacity:.85}
.otbar span{position:relative;z-index:1;font-size:11px;padding:0 10px;color:var(--paper);
  font-family:'IBM Plex Mono',monospace;letter-spacing:.02em}
.chipx{display:inline-flex;align-items:center;gap:4px;font-size:11px;padding:2px 7px;border-radius:99px;
  border:1px solid var(--line);color:var(--mute);white-space:nowrap;font-family:'IBM Plex Mono',monospace}
.chipx.late{color:var(--alert);border-color:color-mix(in srgb,var(--alert) 45%, transparent);
  background:color-mix(in srgb,var(--alert) 12%, transparent)}
.chipx.ontime{color:var(--live);border-color:color-mix(in srgb,var(--live) 45%, transparent)}
.chipx.early{color:var(--live);border-color:color-mix(in srgb,var(--live) 40%, transparent)}

/* detail panel */
.dtl-hd{padding:16px;border-bottom:1px solid var(--line)}
.dtl-hd .x{float:right;cursor:pointer;color:var(--mute);font-size:20px;line-height:1}
.stop{padding:13px 16px;border-bottom:1px solid var(--line);border-left:3px solid var(--dim)}
.stop.delivered{border-left-color:var(--live)} .stop.partial{border-left-color:var(--signal)}
.stop.returned{border-left-color:var(--alert)} .stop.arrived{border-left-color:var(--signal)}
.stop .cust{font-family:'Anuphan';font-weight:700;font-size:15px}
.stop .sub{font-size:12px;color:var(--mute)}
.itm{display:flex;justify-content:space-between;gap:8px;font-size:12px;padding:5px 0;border-bottom:1px dashed var(--line)}
.itm:last-child{border:0}
.itm .s{font-family:'IBM Plex Mono',monospace}
.s.delivered{color:var(--live)} .s.partial{color:var(--signal)} .s.returned{color:var(--alert)} .s.pending{color:var(--mute)}
.btn{background:var(--panel2);border:1px solid var(--line);color:var(--paper);border-radius:8px;
  padding:8px 12px;font-family:inherit;font-size:12px;cursor:pointer}
.btn:hover{border-color:var(--signal)}
.btn.on{background:var(--signal);color:var(--on-signal);border-color:var(--signal)}
.empty{color:var(--mute);padding:22px 16px;font-size:13px;text-align:center}

/* approval queue */
.appr{background:linear-gradient(180deg,rgba(245,165,36,.11),rgba(245,165,36,.02));
  border:1px solid rgba(245,165,36,.45);border-radius:10px;padding:12px;margin-bottom:10px}
.appr .who{font-family:'Anuphan';font-weight:700;font-size:14px}
.appr .sub{font-size:12px;color:var(--mute);margin-top:2px}
.appr .far{font-family:'IBM Plex Mono',monospace;font-size:13px;color:var(--signal);margin-top:6px}
.appr .rsn{font-size:12px;color:var(--paper);background:color-mix(in srgb, var(--ink) 60%, transparent);border-radius:7px;
  padding:7px 9px;margin-top:8px;line-height:1.5}
.appr .acts{display:flex;gap:6px;margin-top:10px}
.appr .acts button{flex:1;padding:8px;font-size:12px;border-radius:7px}
.b-ok{background:var(--live);color:var(--on-live);border:0}
.b-no{background:transparent;color:var(--alert);border:1px solid rgba(229,84,75,.45)}
.b-loc{background:transparent;color:var(--mute);border:1px solid var(--line);flex:0 0 auto!important;padding:8px 10px!important}
@keyframes flash{0%,100%{opacity:1}50%{opacity:.45}}
.blink{animation:flash 1.3s infinite}
@media (prefers-reduced-motion:reduce){.blink{animation:none}}

/* ---------- ปุ่มสลับชั้นข้อมูลบนแผนที่ + คำอธิบายสี ---------- */
.tg{background:var(--panel2);border:1px solid var(--line);color:var(--mute);border-radius:8px;
  padding:6px 11px;font-family:inherit;font-size:12px;cursor:pointer;white-space:nowrap}
.tg:hover{border-color:var(--signal);color:var(--paper)}
.tg.on{background:var(--signal);color:var(--on-signal);border-color:var(--signal)}
.mapwrap{position:relative;min-height:0}
.legend{position:absolute;left:12px;bottom:12px;z-index:500;background:color-mix(in srgb, var(--panel) 94%, transparent);box-shadow:var(--shadow);
  border:1px solid var(--line);border-radius:10px;padding:10px 12px;font-size:12px;max-width:252px;
  max-height:46%;overflow:auto;backdrop-filter:blur(3px)}
.legend .h{font-size:10px;letter-spacing:.14em;text-transform:uppercase;color:var(--mute);margin-bottom:7px}
.legend .r{display:flex;align-items:center;gap:8px;padding:2px 0;cursor:pointer}
.legend .r:hover{color:var(--signal)}
.legend .r.dim{opacity:.45}
.legend .ln{flex:none;width:20px;height:0;border-top:3px solid currentColor;border-radius:2px}
.legend .plate{font-family:'IBM Plex Mono',monospace;font-size:12px}
.legend .n{margin-left:auto;color:var(--mute);font-family:'IBM Plex Mono',monospace;font-size:11px}
.legend .foot{margin-top:8px;padding-top:7px;border-top:1px solid var(--line);color:var(--mute);
  font-size:11px;line-height:1.75}
.legend .foot span{white-space:nowrap}
.vchip{display:inline-block;width:9px;height:9px;border-radius:3px;margin-right:7px;vertical-align:middle}
/* โหมดมืด: กลับสีเฉพาะชั้นพื้นแผนที่ ไม่แตะหมุด/เส้นทาง และไม่ต้องใช้ tile server ที่ต้องมีคีย์ */
:root[data-theme="dark"] .leaflet-tile-pane{
  filter:invert(1) hue-rotate(180deg) brightness(.94) contrast(.9) saturate(.75);
}
.leaflet-container{background:var(--map-bg)}
.leaflet-popup-content-wrapper,.leaflet-popup-tip{background:var(--panel2);color:var(--paper);border-radius:10px}
.leaflet-popup-content{margin:10px 12px;font-family:'IBM Plex Sans Thai',sans-serif;font-size:13px}
.mk{display:grid;place-items:center;border-radius:50%;font-family:'IBM Plex Mono',monospace;
  font-size:11px;font-weight:600;border:2px solid #0E1520}

/* ---------- หมุดแบบไอคอน: รถบรรทุก / กล่องสินค้า / คลัง ---------- */
.tk{position:absolute;left:6px;top:6px;width:30px;height:30px;border-radius:50%;
  display:grid;place-items:center;border:2px solid #0E1520;box-shadow:0 2px 7px rgba(0,0,0,.5)}
.tknum{position:absolute;right:-2px;bottom:-1px;min-width:17px;height:17px;padding:0 3px;
  border-radius:9px;background:#0E1520;color:#E6EDF5;font-family:'IBM Plex Mono',monospace;
  font-size:10px;font-weight:600;display:grid;place-items:center;border:1.5px solid}
.pinum{position:absolute;right:-3px;top:-2px;min-width:17px;height:17px;padding:0 3px;
  border-radius:9px;background:#0E1520;color:#E6EDF5;font-family:'IBM Plex Mono',monospace;
  font-size:10px;font-weight:600;display:grid;place-items:center;border:1.5px solid}
.pinwrap{position:relative;width:30px;height:38px;filter:drop-shadow(0 2px 4px rgba(0,0,0,.45))}
/* เส้นทางที่กำลังวิ่ง — เส้นประไหลไปข้างหน้าแบบ Grab */
.leaflet-overlay-pane path.flow{stroke-dasharray:14 11;animation:flow 1.1s linear infinite}
@keyframes flow{to{stroke-dashoffset:-25}}
@media (prefers-reduced-motion:reduce){.leaflet-overlay-pane path.flow{animation:none}}
.chip{transform:translate(-50%,-50%);background:#12161C;color:#E6EDF5;border:1px solid var(--line);
  border-radius:999px;padding:5px 11px;font-size:12px;font-weight:600;white-space:nowrap;
  box-shadow:0 3px 10px rgba(0,0,0,.55);font-family:'IBM Plex Sans Thai',sans-serif}
.chip .km{font-family:'IBM Plex Mono',monospace;color:#F5A524}
</style>
</head>
<body>
<div class="app">
  <div class="top">
    <h1>ศูนย์ควบคุมการขนส่ง</h1>
    <span class="tag">TMS Live</span>
    <div class="right">
      <button class="tg on" id="tgStops" onclick="tg('stops')">จุดส่ง</button>
      <button class="tg on" id="tgRoute" onclick="tg('route')">ทางที่ต้องวิ่ง</button>
      <button class="tg on" id="tgPast" onclick="tg('past')">ทางที่วิ่งมาแล้ว</button>
      <button class="tg" onclick="fitAll()">ภาพรวม</button>
      <button class="thm" id="themeBtn" onclick="toggleTheme()"></button>
      <span><span class="dot" id="rtDot"></span><span id="rtTxt">กำลังเชื่อมต่อ…</span></span>
      <span class="mono" id="clock"></span>
    </div>
  </div>

  <div class="main" id="main">
    <div class="side">
      <div class="sec">
        <div class="lbl">สรุปวันนี้</div>
        <div class="kpis">
          <div class="kpi"><b id="kRun" style="color:var(--live)">0</b><span>กำลังวิ่ง</span></div>
          <div class="kpi"><b id="kIdle">0</b><span>จอด</span></div>
          <div class="kpi"><b id="kOff">0</b><span>ขาดสัญญาณ</span></div>
          <div class="kpi"><b id="kDone">0</b><span>ส่งสำเร็จ</span></div>
          <div class="kpi"><b id="kLeft">0</b><span>คงเหลือ</span></div>
          <div class="kpi" id="kLateBox"><b id="kLate">0</b><span>เลยเวลา</span></div>
        </div>
        <div class="otbar" id="otBar" style="display:none">
          <div class="otfill" id="otFill"></div><span id="otTxt"></span>
        </div>
      </div>
      <div class="sec" id="apprSec" style="display:none">
        <div class="lbl" style="color:var(--signal)">รออนุมัติจัดส่ง <span id="apprN"></span></div>
        <div id="apprList"></div>
      </div>
      <div class="sec" style="padding-bottom:10px"><div class="lbl">รถทั้งหมด</div></div>
      <div id="vehList"></div>
    </div>

    <div class="mapwrap">
      <div id="map"></div>
      <div class="legend" id="legend" style="display:none"></div>
    </div>

    <div class="side detail" id="detail">
      <div class="dtl-hd">
        <span class="x" onclick="closeDetail()">×</span>
        <div class="disp" style="font-size:17px" id="dPlate">—</div>
        <div style="font-size:12px;color:var(--mute)" id="dDrv"></div>
        <div style="margin-top:10px;display:flex;gap:6px;flex-wrap:wrap">
          <button class="btn" id="bFollow" onclick="toggleFollow()">ตามรถคันนี้</button>
          <button class="btn" onclick="exportCsv()">ส่งออก CSV</button>
        </div>
      </div>
      <div id="dStops"></div>
    </div>
  </div>
</div>

<script>
/* ============================================================
   ตั้งค่า — ใส่ค่าเดียวกับหน้าคนขับ
   ============================================================ */
const SUPABASE_URL = 'https://shtidoddhnbmacbikczo.supabase.co';
const SUPABASE_ANON_KEY = 'sb_publishable_SSdmumG-xWgu0ZzuS8kY8A_NiPa_H-n';
const HOME = [14.0700, 100.6100];   // จุดกึ่งกลางแผนที่เริ่มต้น
const OFFLINE_SEC = 120;            // เกินกี่วินาทีถือว่าขาดสัญญาณ

const sb = supabase.createClient(SUPABASE_URL, SUPABASE_ANON_KEY);
const $ = id => document.getElementById(id);
const today = () => new Date().toISOString().slice(0,10);
const hhmm = d => new Date(d).toLocaleTimeString('th-TH',{hour:'2-digit',minute:'2-digit'});
const ST = {pending:'รอส่ง',arrived:'ถึงแล้ว',delivered:'ส่งครบ',partial:'ส่งบางส่วน',returned:'ตีกลับ'};
const esc = s => String(s??'').replace(/[<>&]/g,c=>({'<':'&lt;','>':'&gt;','&':'&amp;'}[c]));

/* ---------- ธีมมืด/สว่าง ---------- */
const ICON_SUN=`<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
 stroke-linecap="round"><circle cx="12" cy="12" r="4.2"/><path d="M12 2.6v2.2M12 19.2v2.2M4.2 12H2
 M22 12h-2.2M5.6 5.6l1.6 1.6M16.8 16.8l1.6 1.6M18.4 5.6l-1.6 1.6M7.2 16.8l-1.6 1.6"/></svg>`;
const ICON_MOON=`<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"
 stroke-linecap="round" stroke-linejoin="round"><path d="M20 14.4A8.6 8.6 0 1 1 9.6 4a6.9 6.9 0 0 0 10.4 10.4Z"/></svg>`;
const theme = () => document.documentElement.dataset.theme || 'dark';
function setTheme(t, save){
  document.documentElement.dataset.theme = t;
  if(save) try{ localStorage.setItem('tms_theme', t); }catch(e){}
  const b = document.getElementById('themeBtn');
  if(b){ b.innerHTML = t==='light' ? ICON_MOON : ICON_SUN;
    b.title = t==='light' ? 'สลับเป็นโหมดมืด' : 'สลับเป็นโหมดสว่าง'; }
  if(typeof onThemeChange === 'function') onThemeChange(t);
}
window.toggleTheme = () => setTheme(theme()==='light' ? 'dark' : 'light', true);
/* แผนที่: โหมดสว่างใช้ CARTO Voyager (ถนนชัด) · โหมดมืดใช้ CARTO Dark */
/* พื้นแผนที่ใช้ OpenStreetMap มาตรฐาน — ไม่ต้องใช้ API key ไม่ต้องสมัครอะไร
   โหมดมืดไม่ได้เปลี่ยนเป็นเซิร์ฟเวอร์อื่น แต่ใส่ฟิลเตอร์กลับสีเฉพาะชั้นพื้นแผนที่
   (หมุดกับเส้นทางอยู่คนละชั้น จึงไม่โดนกลับสีไปด้วย) */
const TILE_URL  = 'https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png';
const TILE_ATTR = '© OpenStreetMap contributors';

const map = L.map('map',{zoomControl:true}).setView(HOME, 12);
L.tileLayer(TILE_URL,{maxZoom:19, attribution:TILE_ATTR}).addTo(map);
setTheme(theme(), false);

const V = {};              // vehicle_id -> {row, marker, trip, stops}
let sel = null;

/* ---------- ชั้นข้อมูลบนแผนที่ (มี 3 ชั้น เท่านั้น ไม่ซ้อนกัน) ----------
   route = ทางที่ยังต้องวิ่ง (อนาคต)   past = ทางที่วิ่งมาแล้ว (อดีต)   stops = หมุดจุดส่ง   */
const routeLayer = L.layerGroup().addTo(map);
const pastLayer  = L.layerGroup().addTo(map);
const allLayer   = L.layerGroup().addTo(map);
const depotLayer = L.layerGroup().addTo(map);
const RT_PAST  = '#8FA3BF';       // ทางที่วิ่งมาแล้ว — สีกลาง ไม่แย่งสายตา
