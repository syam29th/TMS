<!DOCTYPE html>
<html lang="th">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>TMS · วางแผนเที่ยววิ่ง</title>
<script>/* ตั้งธีมก่อนวาดหน้า กันจอกระพริบตอนโหลด */
try{var _t=localStorage.getItem('tms_theme')||(matchMedia('(prefers-color-scheme: light)').matches?'light':'dark');
document.documentElement.dataset.theme=_t;}catch(e){document.documentElement.dataset.theme='dark';}</script>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Anuphan:wght@500;700&family=IBM+Plex+Sans+Thai:wght@400;500;600&family=IBM+Plex+Mono:wght@500&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css">
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
<script src="https://cdn.sheetjs.com/xlsx-0.20.2/package/dist/xlsx.full.min.js"></script>
<style>
/* ============================================================
   ธีม — มืด (ค่าเริ่มต้นตามเครื่อง) / สว่าง · สลับที่ปุ่มมุมขวาบน จำค่าไว้ในเครื่อง
   โหมดมืด = ใช้ในห้องคุมกลางคืน · โหมดสว่าง = ใช้ในออฟฟิศ/กลางแดด
   ============================================================ */
:root{
  --ink:#0E1520; --panel:#141D2A; --panel2:#1B2636; --line:#26344A;
  --paper:#E6EDF5; --mute:#8A9CB4;
  --signal:#F5A524; --live:#2FD3B8; --alert:#E5544B; --dim:#4A5F7D;
  --on-signal:#12161C; --on-live:#0B1F1B; --on-alert:#FFFFFF;
  --hint-t:#F2D9A8; --map-bg:var(--map-bg);
  --shadow:0 6px 22px rgba(0,0,0,.42);
  color-scheme:dark;
}
:root[data-theme="light"]{
  --ink:#E9EEF5; --panel:#FFFFFF; --panel2:#F2F6FB; --line:#D2DCEA;
  --paper:#132030; --mute:#566780;
  --signal:#BE7009; --live:#0B8C79; --alert:#BC3A30; --dim:#8DA0B7;
  --on-signal:#FFFFFF; --on-live:#FFFFFF; --on-alert:#FFFFFF;
  --hint-t:#7A4A05; --map-bg:#E4EAF1;
  --shadow:0 6px 20px rgba(23,42,71,.14);
  color-scheme:light;
}
.thm{background:transparent;border:1px solid var(--line);color:var(--mute);border-radius:9px;
  padding:7px 9px;cursor:pointer;display:grid;place-items:center;line-height:0;width:auto;flex:none}
.thm:hover{color:var(--signal);border-color:var(--signal)}
.thm svg{width:16px;height:16px;display:block}
*{box-sizing:border-box}
html,body{margin:0;background:var(--ink);color:var(--paper);
  font-family:'IBM Plex Sans Thai',system-ui,sans-serif;font-size:14px}
h1,h2,h3,.disp{font-family:'Anuphan',sans-serif;font-weight:700;margin:0}
.mono{font-family:'IBM Plex Mono',monospace;font-variant-numeric:tabular-nums}
.top{display:flex;align-items:center;gap:18px;padding:0 22px;height:56px;
  border-bottom:1px solid var(--line);background:var(--panel);position:sticky;top:0;z-index:40}
.top h1{font-size:17px} .top .tag{font-size:11px;letter-spacing:.16em;text-transform:uppercase;color:var(--signal)}
.tabs{display:flex;gap:4px;margin-left:auto;flex-wrap:wrap}
.tab{padding:8px 14px;border-radius:8px;cursor:pointer;color:var(--mute);font-size:13px}
.tab:hover{background:var(--panel2)} .tab.on{background:var(--panel2);color:var(--signal)}
.wrap{max-width:1080px;margin:0 auto;padding:22px}
.pane{display:none} .pane.on{display:block}
.card{background:var(--panel);border:1px solid var(--line);border-radius:12px;padding:18px;margin-bottom:16px}
.lbl{font-size:11px;letter-spacing:.16em;text-transform:uppercase;color:var(--mute);margin-bottom:10px}
label.f{display:block;font-size:12px;color:var(--mute);margin:0 0 5px}
input,select,textarea{width:100%;background:var(--panel2);color:var(--paper);border:1px solid var(--line);
  border-radius:8px;padding:9px 10px;font-family:inherit;font-size:14px}
input:focus,select:focus{outline:2px solid var(--signal);outline-offset:-1px}
button{font-family:inherit;font-size:13px;font-weight:600;border:0;border-radius:9px;padding:10px 16px;cursor:pointer}
.btn{background:var(--signal);color:var(--on-signal)} .btn:hover{filter:brightness(1.08)}
.btn-g{background:var(--panel2);color:var(--paper);border:1px solid var(--line)}
.btn-g:hover{border-color:var(--signal)}
.btn-d{background:transparent;color:var(--alert);border:1px solid rgba(229,84,75,.4)}
.btn-s{padding:6px 11px;font-size:12px}
.grid{display:grid;gap:12px}
.g2{grid-template-columns:1fr 1fr} .g3{grid-template-columns:1fr 1fr 1fr} .g4{grid-template-columns:repeat(4,1fr)}
@media(max-width:760px){.g2,.g3,.g4{grid-template-columns:1fr}}
table{width:100%;border-collapse:collapse;font-size:13px}
th{text-align:left;font-size:11px;letter-spacing:.1em;text-transform:uppercase;color:var(--mute);
  padding:8px 10px;border-bottom:1px solid var(--line);font-weight:500}
td{padding:9px 10px;border-bottom:1px solid var(--line);vertical-align:top}
tr:last-child td{border-bottom:0}
.pill{display:inline-block;font-size:11px;padding:3px 9px;border-radius:99px;border:1px solid var(--line);color:var(--mute)}
.pill.run{color:var(--live);border-color:rgba(47,211,184,.5)}
.pill.done{color:var(--dim)} .pill.plan{color:var(--signal);border-color:rgba(245,165,36,.5)}
.drop{border:2px dashed var(--line);border-radius:12px;padding:38px 20px;text-align:center;cursor:pointer;
  transition:.15s;background:var(--panel)}
.drop:hover,.drop.over{border-color:var(--signal);background:var(--panel2)}
.drop .big{font-family:'Anuphan';font-size:17px;font-weight:700;margin-bottom:6px}
.drop .sub{color:var(--mute);font-size:13px}
.stoprow{border-left:3px solid var(--signal);padding:12px 14px;background:var(--panel2);
  border-radius:0 10px 10px 0;margin-bottom:10px}
.itemrow{display:grid;grid-template-columns:1fr 2fr 90px 90px 36px;gap:8px;margin-bottom:7px}
@media(max-width:760px){.itemrow{grid-template-columns:1fr 1fr}}
.x{background:transparent;border:1px solid var(--line);color:var(--mute);border-radius:8px;padding:0;height:36px}
.x:hover{border-color:var(--alert);color:var(--alert)}
.toast{position:fixed;right:22px;bottom:22px;background:var(--panel2);box-shadow:var(--shadow);border:1px solid var(--live);
  border-radius:10px;padding:13px 17px;font-size:13px;display:none;z-index:80;max-width:340px}
.toast.err{border-color:var(--alert)}
.empty{color:var(--mute);text-align:center;padding:26px;font-size:13px}
.note{font-size:12px;color:var(--mute);line-height:1.6}
.hint{background:rgba(245,165,36,.08);border:1px solid rgba(245,165,36,.28);border-radius:9px;
  padding:11px 13px;font-size:12px;color:var(--hint-t);margin-bottom:14px;line-height:1.7}
code{font-family:'IBM Plex Mono',monospace;background:var(--panel2);padding:2px 6px;border-radius:5px;font-size:12px}

/* ---------- Route optimization ---------- */
.rtgrid{display:grid;grid-template-columns:1.15fr .85fr;gap:14px;margin-top:14px}
@media(max-width:860px){.rtgrid{grid-template-columns:1fr}}
#rtMap{height:380px;border-radius:11px;border:1px solid var(--line);background:var(--panel2)}
/* โหมดมืด: กลับสีเฉพาะชั้นพื้นแผนที่ ไม่แตะหมุด/เส้นทาง และไม่ต้องใช้ tile server ที่ต้องมีคีย์ */
:root[data-theme="dark"] .leaflet-tile-pane{
  filter:invert(1) hue-rotate(180deg) brightness(.94) contrast(.9) saturate(.75);
}
.leaflet-container{font-family:'IBM Plex Sans Thai',sans-serif;background:var(--map-bg)}
.leaflet-popup-content-wrapper,.leaflet-popup-tip{background:var(--panel2);color:var(--paper);border-radius:10px}
.leaflet-popup-content{margin:9px 11px;font-size:13px}
.chk{display:flex;align-items:center;gap:7px;font-size:13px;color:var(--mute);cursor:pointer;white-space:nowrap}
.chk input{width:auto}
.src{font-size:11px;letter-spacing:.1em;text-transform:uppercase;color:var(--dim);margin-left:auto}
.cmp{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin-top:14px}
@media(max-width:760px){.cmp{grid-template-columns:1fr}}
.cmpbox{background:var(--panel2);border:1px solid var(--line);border-radius:10px;padding:12px 14px}
.cmpbox.win{border-color:rgba(47,211,184,.55)}
.cmpbox .h{font-size:11px;letter-spacing:.14em;text-transform:uppercase;color:var(--mute);margin-bottom:7px}
.cmpbox .v{font-family:'IBM Plex Mono',monospace;font-size:19px;font-weight:500}
.cmpbox .s{font-size:12px;color:var(--mute);margin-top:3px}
.good{color:var(--live)} .bad{color:var(--alert)} .warnbox{border-color:rgba(229,84,75,.45)}
.seqlist{display:flex;flex-direction:column;gap:7px;max-height:380px;overflow:auto;padding-right:4px}
.seqrow{display:grid;grid-template-columns:26px 1fr auto;gap:10px;align-items:center;
  background:var(--panel2);border:1px solid var(--line);border-radius:9px;padding:9px 11px;cursor:grab}
.seqrow:active{cursor:grabbing}
.seqrow.drag{opacity:.35}
.seqrow.over{border-color:var(--signal);box-shadow:0 -2px 0 var(--signal) inset}
.seqrow.nogeo{border-style:dashed;border-color:rgba(229,84,75,.45)}
.seqrow .n{font-family:'IBM Plex Mono',monospace;font-size:13px;color:var(--signal);text-align:center}
.seqrow .nm{font-size:13px;line-height:1.35}
.seqrow .sub{font-size:11px;color:var(--mute);font-family:'IBM Plex Mono',monospace}
.seqrow .rt{text-align:right;font-family:'IBM Plex Mono',monospace;font-size:12px;color:var(--mute);white-space:nowrap}
.seqrow .rt b{color:var(--paper);font-weight:500}
.mvbtn{background:transparent;border:1px solid var(--line);color:var(--mute);border-radius:6px;
  padding:2px 7px;font-size:12px;line-height:1.4}
.mvbtn:hover{border-color:var(--signal);color:var(--signal)}
.numpin{background:var(--signal);color:var(--on-signal);font-family:'IBM Plex Mono',monospace;font-weight:600;
  border-radius:50%;width:26px;height:26px;display:flex;align-items:center;justify-content:center;
  font-size:12px;border:2px solid #12161C;box-shadow:0 1px 5px rgba(0,0,0,.5)}
.numpin.dep{background:var(--live);border-radius:7px;width:44px;font-family:'IBM Plex Sans Thai',sans-serif;font-size:11px}
</style>
</head>
<body>
<div class="top">
  <h1>วางแผนเที่ยววิ่ง</h1><span class="tag">TMS Planner</span>
  <div class="tabs">
    <div class="tab on" onclick="tab('pTrips',this)">เที่ยววิ่ง</div>
    <div class="tab" onclick="tab('pUpload',this)">อัปโหลด Excel</div>
    <div class="tab" onclick="tab('pCust',this)">ลูกค้า</div>
    <div class="tab" onclick="tab('pDep',this)">จุดรับสินค้า</div>
    <div class="tab" onclick="tab('pVeh',this)">รถ</div>
  </div>
  <button class="thm" id="themeBtn" onclick="toggleTheme()" style="margin-left:10px"></button>
</div>

<div class="wrap">

<div class="pane on" id="pTrips">
  <div class="card">
    <div class="lbl">สร้างเที่ยวใหม่</div>
    <div class="grid g4">
      <div><label class="f">รถ</label><select id="nVeh"></select></div>
      <div><label class="f">จุดรับสินค้า</label><select id="nDep"></select></div>
      <div><label class="f">วันที่วิ่ง</label><input type="date" id="nDate"></div>
      <div><label class="f">หมายเหตุ</label><input id="nNote" placeholder="รอบเช้า"></div>
    </div>
    <div style="margin-top:14px"><button class="btn" onclick="addTrip()">สร้างเที่ยว</button></div>
  </div>

  <div class="card">
    <div style="display:flex;align-items:center;gap:12px;margin-bottom:12px">
      <div class="lbl" style="margin:0">เที่ยวทั้งหมด</div>
      <input type="date" id="fDate" style="width:auto;margin-left:auto" onchange="loadTrips()">
    </div>
    <div id="tripTbl"></div>
  </div>

  <div class="card" id="editBox" style="display:none">
    <div style="display:flex;align-items:center;margin-bottom:14px">
      <div><div class="disp" style="font-size:18px" id="edTitle">—</div>
      <div class="note" id="edSub"></div></div>
      <button class="btn-g btn-s" style="margin-left:auto" onclick="closeEdit()">ปิด</button>
    </div>

    <div class="card" id="rtBox" style="margin-bottom:18px">
      <div class="lbl">จัดเส้นทาง · Route Optimization</div>
      <div class="grid g4">
        <div><label class="f">จุดรับสินค้า (ต้นทาง)</label><select id="rtDepot" onchange="pickDepot(this.value)"></select></div>
        <div><label class="f">พิกัดต้นทาง</label><input id="rtOrigin" class="mono" placeholder="14.0350, 100.6180" onchange="setOrigin(this.value)"></div>
        <div><label class="f">เวลาออกรถ</label><input type="time" id="rtDepart" value="08:00" onchange="recalc()"></div>
        <div><label class="f">เวลาลงของ/จุด (นาที)</label><input type="number" id="rtService" class="mono" value="10" min="0" onchange="recalc()"></div>
      </div>
      <div style="display:flex;gap:9px;align-items:center;margin-top:13px;flex-wrap:wrap">
        <button class="btn" onclick="runAuto()" id="rtRun">คำนวณอัตโนมัติ</button>
        <button class="btn-g" onclick="applyAuto()" id="rtApply" disabled>ใช้ลำดับ Auto</button>
        <button class="btn-g" onclick="undoAuto()" id="rtUndo" disabled>ย้อนกลับลำดับเดิม</button>
        <label class="chk" style="margin-left:6px">เกณฑ์
          <select id="rtObj" style="width:auto;padding:6px 8px" onchange="recalc()">
            <option value="time">เวลาสั้นสุด</option><option value="dist">ระยะทางสั้นสุด</option>
          </select></label>
        <label class="chk"><input type="checkbox" id="rtReturn" onchange="recalc()"> นับเที่ยวกลับคลัง</label>
        <span class="src" id="rtSrc">ยังไม่ได้คำนวณ</span>
      </div>
      <div id="rtWarn"></div>
      <div id="rtCmp" class="cmp"></div>
      <div class="rtgrid">
        <div id="rtMap"></div>
        <div>
          <div class="note" style="margin-bottom:8px">ลากสลับลำดับได้ · ตัวเลขขวามือ = ระยะจากจุดก่อนหน้า และเวลาถึงโดยประมาณ</div>
          <div id="rtList" class="seqlist"></div>
        </div>
      </div>
    </div>

    <div id="edStops"></div>
    <button class="btn-g" onclick="addStop()">+ เพิ่มจุดส่ง</button>
    <button class="btn" style="margin-left:8px" onclick="saveTrip()">บันทึกทั้งหมด</button>
  </div>
</div>

<div class="pane" id="pUpload">
  <div class="hint">1 แถว = สินค้า 1 รายการ · ระบบจัดกลุ่มเป็นเที่ยวและจุดส่งให้เอง จากคอลัมน์ <code>ทะเบียน</code> + <code>วันที่</code> + <code>ลำดับ</code><br>
  จับคู่คอลัมน์ด้วยชื่อหัวตาราง ไม่สนลำดับคอลัมน์ ไม่สนคอลัมน์ส่วนเกิน — ไฟล์เดิมของบริษัทใช้ได้ถ้าหัวตารางตรง</div>
  <div class="card">
    <div class="lbl">ขั้นที่ 1 — เตรียมไฟล์</div>
    <p class="note" style="margin:0 0 12px">ดาวน์โหลดฟอร์มมาตรฐานไปดูโครงสร้าง แล้วปรับหัวตารางไฟล์เดิมให้ตรงกัน</p>
    <button class="btn-g" onclick="dlTemplate()">ดาวน์โหลดฟอร์ม Excel</button>
  </div>
  <div class="card">
    <div class="lbl">ขั้นที่ 2 — อัปโหลด</div>
    <div class="drop" id="drop" onclick="document.getElementById('file').click()">
      <div class="big">ลากไฟล์ Excel มาวางที่นี่</div>
      <div class="sub">หรือคลิกเพื่อเลือกไฟล์ · รองรับ .xlsx .xls .csv</div>
    </div>
    <input type="file" id="file" accept=".xlsx,.xls,.csv" style="display:none">
  </div>
  <div class="card" id="prevBox" style="display:none">
    <div class="lbl">ขั้นที่ 3 — ตรวจก่อนบันทึก</div>
    <div id="prevSum" class="note" style="margin-bottom:12px"></div>
    <div id="prevTbl" style="max-height:340px;overflow:auto"></div>
    <div style="margin-top:14px">
      <button class="btn" onclick="commitImport()">บันทึกเข้าระบบ</button>
      <button class="btn-g" style="margin-left:8px" onclick="cancelImport()">ยกเลิก</button>
    </div>
  </div>
</div>

<div class="pane" id="pCust">
  <div class="hint">คีย์ครั้งเดียว ใช้ซ้ำตลอด · หาพิกัด: Google Maps → คลิกขวาที่จุด → คัดลอกตัวเลขคู่บนสุด มาวางในช่องพิกัดได้ทั้งก้อน</div>
  <div class="card">
    <div class="lbl">เพิ่มลูกค้า</div>
    <div class="grid g4">
      <div><label class="f">รหัส</label><input id="cCode" placeholder="C004"></div>
      <div style="grid-column:span 2"><label class="f">ชื่อลูกค้า</label><input id="cName"></div>
      <div><label class="f">ผู้ติดต่อ</label><input id="cContact"></div>
    </div>
    <div class="grid g3" style="margin-top:12px">
      <div><label class="f">ที่อยู่</label><input id="cAddr"></div>
      <div><label class="f">พิกัด</label><input id="cLatLng" class="mono" placeholder="14.0680, 100.6180"></div>
      <div style="display:flex;align-items:flex-end"><button class="btn" onclick="addCust()">เพิ่มลูกค้า</button></div>
    </div>
  </div>
  <div class="card"><div class="lbl">ทะเบียนลูกค้า</div><div id="custTbl"></div></div>
</div>

<div class="pane" id="pDep">
  <div class="hint">จุดรับสินค้า = ต้นทางของเที่ยว · ระบบใช้จุดนี้เป็นหมุดเริ่มตอนคำนวณลำดับการส่ง<br>
  ตั้ง <b>คลังหลัก</b> ได้ 1 แห่ง — เที่ยวที่สร้างใหม่จะเลือกคลังหลักให้อัตโนมัติ</div>
  <div class="card">
    <div class="lbl">เพิ่มจุดรับสินค้า</div>
    <div class="grid g4">
      <div><label class="f">รหัส</label><input id="dCode" placeholder="D02"></div>
      <div style="grid-column:span 2"><label class="f">ชื่อคลัง / จุดรับ</label><input id="dName"></div>
      <div><label class="f">ที่อยู่</label><input id="dAddr"></div>
    </div>
    <div class="grid g3" style="margin-top:12px">
      <div><label class="f">พิกัด</label><input id="dLatLng" class="mono" placeholder="14.0350, 100.6180"></div>
      <div style="display:flex;align-items:flex-end"><label class="chk"><input type="checkbox" id="dDef"> ตั้งเป็นคลังหลัก</label></div>
      <div style="display:flex;align-items:flex-end"><button class="btn" onclick="addDep()">เพิ่มจุดรับสินค้า</button></div>
    </div>
  </div>
  <div class="card"><div class="lbl">จุดรับสินค้าทั้งหมด</div><div id="depTbl"></div></div>
</div>

<div class="pane" id="pVeh">
  <div class="card">
    <div class="lbl">เพิ่มรถ</div>
    <div class="grid g4">
      <div><label class="f">รหัสรถ</label><input id="vId" placeholder="V06"></div>
      <div><label class="f">ทะเบียน</label><input id="vPlate" placeholder="70-1006 กทม"></div>
      <div><label class="f">คนขับ</label><input id="vDrv"></div>
      <div style="display:flex;align-items:flex-end"><button class="btn" onclick="addVeh()">เพิ่มรถ</button></div>
    </div>
  </div>
  <div class="card"><div class="lbl">รถทั้งหมด</div><div id="vehTbl"></div></div>
</div>

</div>
