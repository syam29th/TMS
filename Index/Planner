    {...base,'ลำดับ':1,'รหัสลูกค้า':'C001','ชื่อลูกค้า':'ร้านค้า A','ที่อยู่':'คลองหลวง ปทุมธานี','lat':14.0680,'lng':100.6180,'รหัสสินค้า':'A-002','ชื่อสินค้า':'กล่องสินค้า B','จำนวน':5,'หน่วย':'กล่อง'},
