  lat:['lat','latitude','ละติจูด'], lng:['lng','lon','longitude','ลองจิจูด'],
  item_code:['รหัสสินค้า','item_code','sku'],
  item_name:['ชื่อสินค้า','สินค้า','item','item_name','รายการ'],
  qty:['จำนวน','qty','qty_plan','จำนวนส่ง'],
  unit:['หน่วย','unit','uom']
};
function mapRow(r){
  const keys = Object.keys(r); const out = {};
  for(const [f,aliases] of Object.entries(COLS)){
    const k = keys.find(k=>{ const t=String(k).trim(); return aliases.includes(t)||aliases.includes(t.toLowerCase()); });
    out[f] = k!=null ? r[k] : null;
  }
  return out;
}
function xlDate(v){
  if(v==null||v==='') return today();
  if(v instanceof Date) return new Date(v.getTime()-v.getTimezoneOffset()*60000).toISOString().slice(0,10);
  if(typeof v==='number') return new Date(Date.UTC(1899,11,30+v)).toISOString().slice(0,10);
  const s=String(v).trim();
  if(/^\d{4}-\d{2}-\d{2}/.test(s)) return s.slice(0,10);
  const m=s.match(/^(\d{1,2})[\/\-](\d{1,2})[\/\-](\d{4})$/);
  if(m){ let y=+m[3]; if(y>2400) y-=543; return `${y}-${String(m[2]).padStart(2,'0')}-${String(m[1]).padStart(2,'0')}`; }
  return today();
}
const drop=$('drop');
['dragover','dragleave','drop'].forEach(e=>drop.addEventListener(e,ev=>{ev.preventDefault();
  drop.classList.toggle('over', e==='dragover');}));
drop.addEventListener('drop', ev=>{ if(ev.dataTransfer.files[0]) readFile(ev.dataTransfer.files[0]); });
$('file').addEventListener('change', e=>{ if(e.target.files[0]) readFile(e.target.files[0]); });

function readFile(f){
  const rd = new FileReader();
  rd.onload = e => {
    let rows;
    try{
      const wb = XLSX.read(e.target.result,{type:'array',cellDates:true});
      rows = XLSX.utils.sheet_to_json(wb.Sheets[wb.SheetNames[0]],{defval:null});
    }catch(err){ return toast('อ่านไฟล์ไม่ได้ ตรวจว่าเป็น Excel หรือ CSV',true); }
    if(!rows.length) return toast('ไฟล์ไม่มีข้อมูล',true);
    buildImport(rows.map(mapRow), f.name);
  };
  rd.readAsArrayBuffer(f);
}

function buildImport(rows, fname){
  const bad = [], trips = new Map();
  rows.forEach((r,i)=>{
    const plate = String(r.vehicle||'').trim();
    const veh = VEH.find(v=>v.plate===plate || v.id===plate);
    if(!veh){ bad.push(`แถว ${i+2}: ไม่พบรถ "${plate||'(ว่าง)'}" ในระบบ`); return; }
    if(!r.item_name){ bad.push(`แถว ${i+2}: ไม่มีชื่อสินค้า`); return; }
    const date = xlDate(r.date), tk = veh.id+'|'+date;
    if(!trips.has(tk)) trips.set(tk,{vehicle_id:veh.id, plate:veh.plate, trip_date:date, stops:new Map()});
    const T = trips.get(tk);
    const seq = parseInt(r.seq)||T.stops.size+1;
    if(!T.stops.has(seq)){
      const c = r.cust_code ? CUST.find(x=>x.code===String(r.cust_code).trim()) : null;
      T.stops.set(seq,{seq, customer_id:c?.id||null,
        customer: String(r.customer||c?.name||'').trim() || 'ไม่ระบุลูกค้า',
        address: r.address || c?.address || null,
        dest_lat: (r.lat!=null&&r.lat!=='') ? parseFloat(r.lat) : (c?.lat ?? null),
        dest_lng: (r.lng!=null&&r.lng!=='') ? parseFloat(r.lng) : (c?.lng ?? null),
        items:[]});
    }
    T.stops.get(seq).items.push({item_code:r.item_code?String(r.item_code):null,
      item_name:String(r.item_name).trim(), qty_plan:parseFloat(r.qty)||1, unit:r.unit?String(r.unit):'ชิ้น'});
  });
  IMP = [...trips.values()].map(t=>({...t, stops:[...t.stops.values()].sort((a,b)=>a.seq-b.seq)}));
  const nStops = IMP.reduce((a,t)=>a+t.stops.length,0);
  const nItems = IMP.reduce((a,t)=>a+t.stops.reduce((b,s)=>b+s.items.length,0),0);
  $('prevSum').innerHTML = `<b style="color:var(--paper)">${esc(fname)}</b> → ${IMP.length} เที่ยว · ${nStops} จุดส่ง · ${nItems} รายการ`
    + (bad.length?`<div style="color:var(--alert);margin-top:8px">ข้าม ${bad.length} แถว:<br>${bad.slice(0,8).map(esc).join('<br>')}${bad.length>8?'<br>…':''}</div>`:'');
  $('prevTbl').innerHTML = `<table><tr><th>รถ</th><th>วันที่</th><th>ลำดับ</th><th>ลูกค้า</th><th>พิกัด</th><th>สินค้า</th></tr>`+
    IMP.flatMap(t=>t.stops.map(s=>`<tr><td>${esc(t.plate)}</td><td class="mono">${t.trip_date}</td>
      <td class="mono">${s.seq}</td><td>${esc(s.customer)}</td>
      <td class="mono" style="font-size:11px;color:${s.dest_lat?'var(--live)':'var(--dim)'}">${s.dest_lat?'มี':'ไม่มี'}</td>
      <td class="note">${s.items.map(i=>esc(i.item_name)+' ×'+i.qty_plan).join(', ')}</td></tr>`)).join('')+`</table>`;
  $('prevBox').style.display='block';
  $('prevBox').scrollIntoView({behavior:'smooth',block:'start'});
  if(!IMP.length) toast('ไม่มีแถวที่ใช้ได้เลย ตรวจชื่อคอลัมน์และทะเบียนรถ',true);
}
window.cancelImport = () => { IMP=null; $('prevBox').style.display='none'; $('file').value=''; };
window.commitImport = async () => {
  if(!IMP?.length) return;
  const firstDate = IMP[0].trip_date; let n=0;
  for(const t of IMP){
    const dd = DEP.find(x=>x.is_default);
    const {data:tr,error} = await sb.from('trips').insert({vehicle_id:t.vehicle_id,
      trip_date:t.trip_date, note:'นำเข้าจาก Excel',
      depot_id:dd?.id||null, origin_name:dd?.name||null, origin_lat:dd?.lat??null, origin_lng:dd?.lng??null,
      depart_at:'08:00', service_min:10}).select().single();
    if(error){ return toast('บันทึกไม่สำเร็จ: '+error.message,true); }
    for(const s of t.stops){
      const {data:ns} = await sb.from('stops').insert({trip_id:tr.id, seq:s.seq, customer:s.customer,
        address:s.address, customer_id:s.customer_id, dest_lat:s.dest_lat, dest_lng:s.dest_lng}).select().single();
      await sb.from('items').insert(s.items.map(i=>({stop_id:ns.id, ...i})));
    }
    n++;
  }
  toast(`นำเข้า ${n} เที่ยวเรียบร้อย`); cancelImport(); $('fDate').value=firstDate; loadTrips();
};

