  if(!cid){ s.customer_id=null; return renderEd(); }
  const c=CUST.find(x=>x.id==cid);
  s.customer_id=c.id; s.customer=c.name; s.address=c.address||''; s.dest_lat=c.lat; s.dest_lng=c.lng;
  AUTO=null; $('rtApply').disabled=true; renderEd(); recalc(); };

window.saveTrip = async () => {
  for(const s of ED.stops){
    if(!s.customer?.trim()) return toast('มีจุดส่งที่ยังไม่ได้ใส่ชื่อลูกค้า',true);
    if(!s.items.length || s.items.some(i=>!i.item_name?.trim()))
      return toast(`จุดส่ง "${s.customer}" มีสินค้าที่ยังไม่ใส่ชื่อ`,true);
  }
  const plan = PLAN;                                   // ผลคำนวณล่าสุดของลำดับที่เห็นอยู่
  await sb.from('stops').delete().eq('trip_id',ED.id);
  for(const s of ED.stops){
    const leg = plan?.byUid?.[uid(s)] || {};
    const {data:ns,error} = await sb.from('stops').insert({trip_id:ED.id, seq:s.seq, customer:s.customer,
      address:s.address||null, customer_id:s.customer_id||null,
      dest_lat:s.dest_lat, dest_lng:s.dest_lng, status:'pending',
      leg_distance_m:leg.d??null, leg_duration_s:leg.t??null, eta:leg.eta??null}).select().single();
    if(error) return toast('บันทึกไม่สำเร็จ: '+error.message,true);
    if(s.items.length) await sb.from('items').insert(s.items.map(i=>({stop_id:ns.id,
      item_code:i.item_code||null, item_name:i.item_name, qty_plan:i.qty_plan||1, unit:i.unit||'ชิ้น'})));
  }
  await sb.from('trips').update({
    depot_id:ED.depot_id||null, origin_name:ED.origin_name||null,
    origin_lat:ED.origin_lat??null, origin_lng:ED.origin_lng??null,
    route_mode:ED.route_mode||'manual', route_src:MTX?.src||null,
    route_objective:$('rtObj').value==='dist'?'distance':'time',
    plan_return:$('rtReturn').checked,
    plan_distance_m:plan?.d??null, plan_duration_s:plan?.t??null,
    depart_at:$('rtDepart').value||null, service_min:parseInt($('rtService').value)||0,
    optimized_at: plan ? new Date().toISOString() : null
  }).eq('id',ED.id);
  toast('บันทึกเรียบร้อย คนขับเห็นงานแล้ว'); loadTrips();
};

/* ============================================================
   ROUTE OPTIMIZATION
   โจทย์: ออกจากจุดรับสินค้า 1 จุด → ส่งหลายจุด → จบที่จุดสุดท้าย
          (open-route TSP; ติ๊ก "นับเที่ยวกลับคลัง" ถ้าต้องวิ่งกลับ)
   วิธี:  1) ขอ matrix ระยะทาง/เวลาถนนจริง  ORS → OSRM → เส้นตรง×1.3
          2) Nearest Neighbour หาลำดับตั้งต้น
          3) 2-opt + Or-opt ขัดจนไม่ดีขึ้น  (n ไม่เกิน ~40 เร็วพอในเบราว์เซอร์)
   ============================================================ */
let MAP=null, LAYER=null, MTX=null, AUTO=null, SNAP=null, PLAN=null, GAIN=null, orsDown=0;

const R2 = x => Math.round(x*10)/10;
const km = m => (m/1000).toFixed(1)+' กม.';
const hm = s => { const t=Math.round(s/60); return t>=60 ? `${Math.floor(t/60)} ชม. ${t%60} น.` : `${t} น.`; };
function haversine(a,b){
  const rad=Math.PI/180, dLat=(b.lat-a.lat)*rad, dLng=(b.lng-a.lng)*rad;
  const x=Math.sin(dLat/2)**2 + Math.cos(a.lat*rad)*Math.cos(b.lat*rad)*Math.sin(dLng/2)**2;
  return 6371000*2*Math.atan2(Math.sqrt(x),Math.sqrt(1-x));
}
let UIDN=0;
const uid = s => (s._uid || (s._uid = 'u'+(++UIDN)));     // ตัวระบุจุดส่งที่ไม่เปลี่ยนตามการสลับลำดับ
const ck  = s => uid(s)+'@'+s.dest_lat.toFixed(5)+','+s.dest_lng.toFixed(5);
const mtxKey = g => `${ED.origin_lat},${ED.origin_lng}|`+g.map(ck).slice().sort().join('|');
const geoStops = () => ED.stops.filter(s=>s.dest_lat!=null && s.dest_lng!=null);
const noGeo    = () => ED.stops.filter(s=>s.dest_lat==null || s.dest_lng==null);
const hasOrigin= () => ED && ED.origin_lat!=null && ED.origin_lng!=null;

/* ---------- matrix: ORS → OSRM → ประมาณจากเส้นตรง ---------- */
async function matrixORS(pts){
  if(!ORS_KEY || Date.now()-orsDown < 600000) return null;
  try{
    const r = await fetch('https://api.openrouteservice.org/v2/matrix/driving-car',{
      method:'POST', headers:{'Authorization':ORS_KEY,'Content-Type':'application/json'},
      body: JSON.stringify({locations:pts.map(p=>[p.lng,p.lat]), metrics:['distance','duration'], units:'m'})});
    if(!r.ok){ if(r.status===403||r.status===429) orsDown=Date.now(); return null; }
    const j = await r.json();
    if(!j.distances || !j.durations) return null;
    return {dist:j.distances, dur:j.durations, src:'ORS'};
  }catch(e){ return null; }
}
async function matrixOSRM(pts){
  try{
    const c = pts.map(p=>p.lng+','+p.lat).join(';');
    const r = await fetch(`https://router.project-osrm.org/table/v1/driving/${c}?annotations=distance,duration`);
    const j = await r.json();
    if(j.code!=='Ok' || !j.distances) return null;
    return {dist:j.distances, dur:j.durations, src:'OSRM'};
  }catch(e){ return null; }
}
function matrixEst(pts){                       // เส้นตรง × 1.3 ที่ 35 กม./ชม. — ใช้ตอนออฟไลน์
  const F=1.3, V=35/3.6;
  const d = pts.map(a=>pts.map(b=>haversine(a,b)*F));
  return {dist:d, dur:d.map(row=>row.map(x=>x/V)), src:'EST'};
}
async function buildMatrix(pts){
  return (await matrixORS(pts)) || (await matrixOSRM(pts)) || matrixEst(pts);
}

/* ---------- ต้นทุนของลำดับหนึ่ง ๆ (node 0 = จุดรับสินค้า) ---------- */
function cost(order, M, back, obj){
  const A = obj==='dist' ? M.dist : M.dur;
  let v=0, d=0, t=0, p=0;
  for(const i of order){ v+=A[p][i]; d+=M.dist[p][i]; t+=M.dur[p][i]; p=i; }
  if(back){ v+=A[p][0]; d+=M.dist[p][0]; t+=M.dur[p][0]; }
  return {v,d,t};
}
function nearestNeighbour(M, n, obj){
  const A = obj==='dist' ? M.dist : M.dur;
  const left = new Set(); for(let i=1;i<=n;i++) left.add(i);
  const o=[]; let p=0;
  while(left.size){
    let best=null, bv=Infinity;
    for(const i of left){ if(A[p][i]<bv){ bv=A[p][i]; best=i; } }
    o.push(best); left.delete(best); p=best;
  }
  return o;
}
function twoOpt(o, M, back, obj){
  let best = cost(o,M,back,obj).v, guard=0;
  for(let improved=true; improved && guard++<80; ){
    improved=false;
    for(let i=0;i<o.length-1 && !improved;i++)
      for(let k=i+1;k<o.length;k++){
        const c = o.slice(0,i).concat(o.slice(i,k+1).reverse(), o.slice(k+1));
        const v = cost(c,M,back,obj).v;
        if(v < best-1e-6){ o=c; best=v; improved=true; break; }
      }
  }
  return o;
}
function orOpt(o, M, back, obj){                 // ย้ายก้อน 1-3 จุดไปแทรกที่อื่น
  let best = cost(o,M,back,obj).v, guard=0;
  for(let improved=true; improved && guard++<80; ){
    improved=false;
    outer:
    for(let L=1;L<=3;L++)
      for(let i=0;i+L<=o.length;i++){
        const seg=o.slice(i,i+L), rest=o.slice(0,i).concat(o.slice(i+L));
        for(let j=0;j<=rest.length;j++){
          if(j===i) continue;
          const c = rest.slice(0,j).concat(seg, rest.slice(j));
          const v = cost(c,M,back,obj).v;
          if(v < best-1e-6){ o=c; best=v; improved=true; break outer; }
        }
      }
  }
  return o;
}
function insertion(M, n, back, obj){        // cheapest-insertion เริ่มจากจุดไกลคลังที่สุด
  const A = obj==='dist' ? M.dist : M.dur;
  const left = new Set(); for(let i=1;i<=n;i++) left.add(i);
  let f=null, fv=-1; for(const i of left){ if(A[0][i]>fv){ fv=A[0][i]; f=i; } }
  const o=[f]; left.delete(f);
  while(left.size){
    let bi=null, bp=0, bv=Infinity;
    for(const i of left) for(let p=0;p<=o.length;p++){
      const v = cost(o.slice(0,p).concat([i], o.slice(p)), M, back, obj).v;
      if(v<bv){ bv=v; bi=i; bp=p; }
    }
    o.splice(bp,0,bi); left.delete(bi);
  }
  return o;
}
function doubleBridge(o){                   // เขย่าลำดับให้หลุดจากหลุมพราง local optimum
  const n=o.length, a=o.slice();
  if(n<8){ const i=Math.floor(Math.random()*n), j=Math.floor(Math.random()*n);
    [a[i],a[j]]=[a[j],a[i]]; return a; }
  const cuts=[1+Math.floor(Math.random()*(n-3)), 1+Math.floor(Math.random()*(n-3)), 1+Math.floor(Math.random()*(n-3))]
    .sort((x,y)=>x-y);
  const [p1,p2,p3]=cuts;
  return a.slice(0,p1).concat(a.slice(p2,p3), a.slice(p1,p2), a.slice(p3));
}
function solve(M, n, back, obj){
  if(n<=1) return n===1?[1]:[];
  const ls = o => { for(let i=0;i<3;i++){ o=twoOpt(o,M,back,obj); o=orOpt(o,M,back,obj); } return o; };
  let best = ls(nearestNeighbour(M,n,obj)), bv = cost(best,M,back,obj).v;
  const alt = ls(insertion(M,n,back,obj)), av = cost(alt,M,back,obj).v;
  if(av < bv){ best=alt; bv=av; }
  let cur = best.slice(), stall = 0;
  const kicks = n<=4 ? 0 : (n<=20 ? 120 : 40);
  for(let k=0;k<kicks;k++){
    const o = ls(doubleBridge(cur)), v = cost(o,M,back,obj).v;
    if(v < bv-1e-9){ best=o; bv=v; cur=o; stall=0; }
    else if(++stall >= 15){                 // ติดหลุม — สุ่มลำดับใหม่แล้วขัดอีกรอบ
      const r = best.slice();
      for(let i=r.length-1;i>0;i--){ const j=Math.floor(Math.random()*(i+1)); [r[i],r[j]]=[r[j],r[i]]; }
      cur = ls(r); stall = 0;
      const rv = cost(cur,M,back,obj).v; if(rv < bv-1e-9){ best=cur.slice(); bv=rv; }
    }
  }
  return best;
}

/* ---------- แผงจัดเส้นทาง ---------- */
function initRoute(){
  AUTO=null; SNAP=null; MTX=null; PLAN=null; GAIN=null;
  $('rtDepot').innerHTML = depOptions(ED.depot_id);
  $('rtOrigin').value = hasOrigin() ? ED.origin_lat+', '+ED.origin_lng : '';
  $('rtDepart').value = (ED.depart_at||'08:00').slice(0,5);
  $('rtService').value = ED.service_min ?? 10;
  $('rtReturn').checked = !!ED.plan_return;
  $('rtObj').value = ED.route_objective==='distance' ? 'dist' : 'time';
  $('rtApply').disabled = true; $('rtUndo').disabled = true;
  $('rtSrc').textContent = 'ยังไม่ได้คำนวณ';
  $('rtCmp').innerHTML = '';
  drawMap(); recalc();
}
window.pickDepot = id => {
  const d = DEP.find(x=>x.id==id);
  ED.depot_id = d?.id||null; ED.origin_name = d?.name||null;
  ED.origin_lat = d?.lat??null; ED.origin_lng = d?.lng??null;
  $('rtOrigin').value = hasOrigin() ? ED.origin_lat+', '+ED.origin_lng : '';
  AUTO=null; MTX=null; $('rtApply').disabled=true; recalc();
};
window.setOrigin = v => {
  const ll = parseLL(v); ED.origin_lat=ll.lat; ED.origin_lng=ll.lng;
  if(ll.lat!=null && !ED.origin_name) ED.origin_name='จุดรับสินค้า';
  AUTO=null; MTX=null; $('rtApply').disabled=true; recalc();
};

/* คำนวณตัวเลขของ "ลำดับที่เห็นอยู่ตอนนี้" แล้ววาดใหม่ */
async function recalc(){
  if(!ED) return;
  const g = geoStops();
  let warn = [];
  if(!hasOrigin()) warn.push('ยังไม่ได้ระบุจุดรับสินค้า — เลือกคลังหรือวางพิกัดต้นทางก่อน');
  if(noGeo().length) warn.push(`${noGeo().length} จุดยังไม่มีพิกัด — ไม่ถูกนำมาคำนวณ และจะถูกต่อท้ายลำดับ`);
  $('rtWarn').innerHTML = warn.length
    ? `<div class="hint" style="margin:12px 0 0;border-color:rgba(229,84,75,.35);background:rgba(229,84,75,.07);color:#F0B7B2">${warn.join('<br>')}</div>` : '';

  if(hasOrigin() && g.length){
    const k = mtxKey(g);
    if(!MTX || MTX.key!==k){                     // ขอ matrix ใหม่เฉพาะตอนจุด/พิกัดเปลี่ยน ไม่ใช่ตอนสลับลำดับ
      $('rtSrc').textContent='กำลังขอระยะทางถนนจริง…';
      const pts = [{lat:ED.origin_lat,lng:ED.origin_lng}, ...g.map(s=>({lat:s.dest_lat,lng:s.dest_lng}))];
      MTX = await buildMatrix(pts);
      MTX.idx={}; MTX.stopOf={};
      g.forEach((s,i)=>{ MTX.idx[uid(s)]=i+1; MTX.stopOf[i+1]=s; });
      MTX.key = k;
      $('rtSrc').textContent = 'ระยะจาก: '+({ORS:'OpenRouteService',OSRM:'OSRM',EST:'ประมาณจากเส้นตรง ×1.3'}[MTX.src]);
    }
    PLAN = measure(g.map(s=>MTX.idx[uid(s)]));   // ลำดับที่เห็นอยู่ตอนนี้
  } else { PLAN=null; MTX=null; }
  renderCmp(); renderList(); drawMap();
}

/* วัดผลของลำดับหนึ่ง ๆ + แตกเป็นราย leg พร้อม ETA */
function measure(order){
  const back = $('rtReturn').checked, obj = $('rtObj').value;
  const c = cost(order, MTX, back, obj);
  const svc = (parseInt($('rtService').value)||0)*60;
  const [hh,mm] = ($('rtDepart').value||'08:00').split(':').map(Number);
  let clock = (hh*3600+mm*60), p=0;
  const legs = order.map(i=>{
    const d=MTX.dist[p][i], t=MTX.dur[p][i]; p=i; clock += t;
    const eta = fmtClock(clock); clock += svc;
    return {d,t,eta};
  });
  const byUid={}; order.forEach((i,k)=>{ byUid[uid(MTX.stopOf[i])] = legs[k]; });
  return {order, d:c.d, t:c.t, legs, byUid, back};
}
const fmtClock = s => { const x=Math.round(s/60)%1440;
  return String(Math.floor(x/60)).padStart(2,'0')+':'+String(x%60).padStart(2,'0'); };

window.runAuto = async () => {
  if(!hasOrigin()) return toast('เลือกจุดรับสินค้าก่อน',true);
  const g = geoStops();
  if(g.length<2) return toast('ต้องมีจุดส่งที่มีพิกัดอย่างน้อย 2 จุด',true);
  $('rtRun').disabled=true; $('rtRun').textContent='กำลังคำนวณ…';
  await recalc();
  const order = solve(MTX, g.length, $('rtReturn').checked, $('rtObj').value);
  AUTO = measure(order);
  $('rtRun').disabled=false; $('rtRun').textContent='คำนวณอัตโนมัติ';
  $('rtApply').disabled = false;
  renderCmp(); drawMap();
  const save = PLAN.t - AUTO.t;
  toast(save>30 ? `Auto เร็วกว่าลำดับปัจจุบัน ${hm(save)}` : 'ลำดับปัจจุบันดีอยู่แล้ว Auto ไม่ได้ดีขึ้นชัดเจน');
};

window.applyAuto = () => {
  if(!AUTO) return;
  SNAP = ED.stops.slice();                       // เก็บลำดับเดิมไว้ย้อนกลับ
  GAIN = {d: PLAN.d-AUTO.d, t: PLAN.t-AUTO.t, from: PLAN.d};
  const reordered = AUTO.order.map(i=>MTX.stopOf[i]);
  ED.stops = reordered.concat(noGeo());
  ED.stops.forEach((s,i)=>s.seq=i+1);
  ED.route_mode='auto';
  $('rtUndo').disabled=false; $('rtApply').disabled=true; AUTO=null;
  renderEd(); recalc(); toast('ใช้ลำดับ Auto แล้ว — กด "บันทึกทั้งหมด" เพื่อส่งให้คนขับ');
};
window.undoAuto = () => {
  if(!SNAP) return;
  ED.stops = SNAP; SNAP=null; GAIN=null; ED.route_mode='manual';
  ED.stops.forEach((s,i)=>s.seq=i+1);
  $('rtUndo').disabled=true; renderEd(); recalc(); toast('ย้อนกลับลำดับเดิมแล้ว');
};

function renderCmp(){
  if(!PLAN){ $('rtCmp').innerHTML=''; return; }
  const box = (h,v,s,cls='') => `<div class="cmpbox ${cls}"><div class="h">${h}</div><div class="v">${v}</div><div class="s">${s}</div></div>`;
  let html = box(ED.route_mode==='auto'?'ลำดับปัจจุบัน (Auto)':'ลำดับปัจจุบัน (Manual)',
    km(PLAN.d), hm(PLAN.t)+' · '+PLAN.order.length+' จุด'+($('rtReturn').checked?' · รวมเที่ยวกลับ':''));
  if(AUTO){
    const dd = PLAN.d-AUTO.d, dt = PLAN.t-AUTO.t;
    const pct = PLAN.d>0 ? (dd/PLAN.d*100) : 0;
    html += box('Auto optimize', km(AUTO.d), hm(AUTO.t), dt>0?'win':'');
    html += box('ส่วนต่าง',
      `<span class="${dd>0?'good':'bad'}">${dd>0?'−':'+'}${km(Math.abs(dd))}</span>`,
      `${dd>0?'ประหยัด':'แย่ลง'} ${hm(Math.abs(dt))} · ${Math.abs(pct).toFixed(0)}%`, dd>0?'win':'warnbox');
  } else if(GAIN && ED.route_mode==='auto'){
    html += box('ก่อนจัด (Manual)', km(GAIN.from), 'ลำดับที่คีย์เข้ามาตอนแรก');
    html += box('ผลที่ได้',
      `<span class="${GAIN.d>0?'good':'bad'}">${GAIN.d>0?'−':'+'}${km(Math.abs(GAIN.d))}</span>`,
      `${GAIN.d>0?'ประหยัด':'แย่ลง'} ${hm(Math.abs(GAIN.t))} · ${(Math.abs(GAIN.d/GAIN.from*100)).toFixed(0)}%`,
      GAIN.d>0?'win':'warnbox');
  } else {
    html += box('Auto optimize','—','กด "คำนวณอัตโนมัติ" เพื่อเทียบ');
    html += box('ส่วนต่าง','—','ยังไม่มีผลเทียบ');
  }
  $('rtCmp').innerHTML = html;
}

function renderList(){
  const g = geoStops(), ng = noGeo();
  const rows = ED.stops.map((s,i)=>{
    const gi = g.indexOf(s);
    const leg = (gi>=0 && PLAN) ? PLAN.legs[gi] : null;
    return `<div class="seqrow ${gi<0?'nogeo':''}" draggable="true" data-i="${i}">
      <div class="n">${i+1}</div>
      <div><div class="nm">${esc(s.customer||'(ยังไม่ใส่ชื่อ)')}</div>
        <div class="sub">${gi<0 ? 'ไม่มีพิกัด' : s.dest_lat.toFixed(4)+', '+s.dest_lng.toFixed(4)}</div></div>
      <div class="rt">${leg ? `<b>${km(leg.d)}</b><br>ถึง ${leg.eta} น.` :
        `<button class="mvbtn" onclick="mv(${i},-1)">↑</button>
         <button class="mvbtn" onclick="mv(${i},1)">↓</button>`}</div>
    </div>`;
  }).join('');
  $('rtList').innerHTML = rows || '<div class="empty">ยังไม่มีจุดส่ง</div>';
  bindDrag();
}
window.mv = (i,d) => { const j=i+d; if(j<0||j>=ED.stops.length) return;
  const a=ED.stops; [a[i],a[j]]=[a[j],a[i]]; a.forEach((s,n)=>s.seq=n+1);
  ED.route_mode='manual'; GAIN=null; renderEd(); recalc(); };

let dragI=null;
function bindDrag(){
  $('rtList').querySelectorAll('.seqrow').forEach(el=>{
    el.addEventListener('dragstart',e=>{ dragI=+el.dataset.i; el.classList.add('drag');
      e.dataTransfer.effectAllowed='move'; });
    el.addEventListener('dragend',()=>{ el.classList.remove('drag');
      $('rtList').querySelectorAll('.seqrow').forEach(x=>x.classList.remove('over')); });
    el.addEventListener('dragover',e=>{ e.preventDefault(); el.classList.add('over'); });
    el.addEventListener('dragleave',()=>el.classList.remove('over'));
    el.addEventListener('drop',e=>{ e.preventDefault();
      const to=+el.dataset.i; if(dragI==null||dragI===to) return;
      const a=ED.stops, [m]=a.splice(dragI,1); a.splice(to,0,m);
      a.forEach((s,n)=>s.seq=n+1); dragI=null;
      ED.route_mode='manual'; GAIN=null; renderEd(); recalc(); });
  });
}

function drawMap(){
  if(!MAP){
    MAP = L.map('rtMap',{zoomControl:true, attributionControl:false}).setView([14.03,100.62],11);
    L.tileLayer(TILE_URL,{maxZoom:19}).addTo(MAP);
  }
  if(LAYER) MAP.removeLayer(LAYER);
  LAYER = L.layerGroup().addTo(MAP);
  const pts=[];
  if(hasOrigin()){
    const o=[ED.origin_lat,ED.origin_lng]; pts.push(o);
    L.marker(o,{icon:L.divIcon({className:'',html:'<div class="numpin dep">คลัง</div>',
      iconSize:[44,26],iconAnchor:[22,13]})}).addTo(LAYER)
      .bindPopup('จุดรับสินค้า: '+esc(ED.origin_name||'—'));
  }
  const g = geoStops();
  g.forEach((s,i)=>{
    const p=[s.dest_lat,s.dest_lng]; pts.push(p);
    L.marker(p,{icon:L.divIcon({className:'',html:`<div class="numpin">${ED.stops.indexOf(s)+1}</div>`,
      iconSize:[26,26],iconAnchor:[13,13]})}).addTo(LAYER).bindPopup(esc(s.customer||'—'));
  });
  if(hasOrigin() && g.length){
    const line = [[ED.origin_lat,ED.origin_lng], ...g.map(s=>[s.dest_lat,s.dest_lng])];
    if($('rtReturn').checked) line.push([ED.origin_lat,ED.origin_lng]);
    L.polyline(line,{color:'#F5A524',weight:3,opacity:.85}).addTo(LAYER);
    if(AUTO && MTX){
      const al = [[ED.origin_lat,ED.origin_lng],
        ...AUTO.order.map(i=>[MTX.stopOf[i].dest_lat, MTX.stopOf[i].dest_lng])];
      if($('rtReturn').checked) al.push([ED.origin_lat,ED.origin_lng]);
      L.polyline(al,{color:'#2FD3B8',weight:3,opacity:.9,dashArray:'7 6'}).addTo(LAYER);
    }
  }
  if(pts.length){ MAP.fitBounds(L.latLngBounds(pts).pad(.25)); }
  setTimeout(()=>MAP.invalidateSize(),120);
}

