            <option value="">— พิมพ์เอง —</option>${opt(s.customer_id)}</select></div>
        <div style="display:flex;align-items:flex-end;justify-content:flex-end">
          <button class="btn-d btn-s" onclick="delStop(${si})">ลบจุดส่ง</button></div>
      </div>
      <div class="grid g3" style="margin-bottom:12px">
